  m_text: "\u0422\u0430\u043A, \u0421\u0430\u0448\u0430, \u044F \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0430
    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D, \u0442\u0430\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043A\u043E\u043B\u0431\u0430\u0441\u0443 '\u0434\u043E\u043A\u0442\u043E\u0440\u0441\u043A\u0443\u044E'
