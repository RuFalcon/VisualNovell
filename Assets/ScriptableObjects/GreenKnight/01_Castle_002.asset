  character: {fileID: 0}
  backgroundSprite: {fileID: 7457602803753497852, guid: d455227385c9b264eb83c9400c423ae6, type: 3}
  dialogueText: "\u0422\u044B, \u0413\u0430\u0432\u0435\u0439\u043D, \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A
    \u043A\u043E\u0440\u043E\u043B\u044F. \u0422\u044B \u0441\u0438\u0434\u0438\u0448\u044C
    \u0432\u043E \u0433\u043B\u0430\u0432\u0435 \u0441\u0442\u043E\u043B\u0430 \u0438
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C \u044D\u0442\u0443
    \u0441\u0442\u044B\u043B\u0443\u044E \u043F\u0443\u0441\u0442\u043E\u0442\u0443
    \u043E\u0441\u0442\u0440\u0435\u0435 \u0434\u0440\u0443\u0433\u0438\u0445. \u0421\u043B\u0430\u0432\u0430
    \u043E \u0442\u0432\u043E\u0435\u0439 \u0443\u0447\u0442\u0438\u0432\u043E\u0441\u0442\u0438
    \u0438 \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u0438 \u0433\u0440\u0435\u043C\u0435\u043B\u0430
    \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0443,
    \u043D\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0442\u0435\u0431\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
    \u044D\u0442\u043E \u043B\u0438\u0448\u044C \u043F\u043E\u0437\u043E\u043B\u043E\u0447\u0435\u043D\u043D\u0430\u044F
    \u043C\u0430\u0441\u043A\u0430, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C.
    \u041F\u043E\u0434\u0432\u0438\u0433\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
    \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u043E\u0439, \u0430 \u0447\u0435\u0441\u0442\u044C
    - \u0442\u044F\u0436\u0435\u043B\u044B\u043C \u0431\u0440\u0435\u043C\u0435\u043D\u0435\u043C."
