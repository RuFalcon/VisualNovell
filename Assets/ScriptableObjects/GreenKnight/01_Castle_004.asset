  backgroundSprite: {fileID: -6243161541749663586, guid: d9f87a6121e56ca4d9686cb530f2092e, type: 3}
  dialogueText: "\u041E\u043D \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E \u0432\u044A\u0435\u0445\u0430\u043B
    \u0432 \u0437\u0430\u043B, \u0438 \u0441\u0442\u0443\u043A \u043A\u043E\u043F\u044B\u0442
    \u0435\u0433\u043E \u043A\u043E\u043D\u044F \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C\u0443
    \u043F\u043E\u043B\u0443 \u0437\u0432\u0443\u0447\u0430\u043B, \u043A\u0430\u043A
    \u0443\u0434\u0430\u0440\u044B \u043C\u043E\u0433\u0438\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u043E\u043B\u043E\u0442\u0430. \u0412 \u043E\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u0435
    \u043E\u043D \u0434\u0435\u0440\u0436\u0430\u043B \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E
    \u0441\u0435\u043A\u0438\u0440\u0443 \u0438\u0437 \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E
    \u043C\u0435\u0442\u0430\u043B\u043B\u0430, \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
    - \u0432\u0435\u0442\u0432\u044C \u043E\u0441\u0442\u0440\u043E\u043B\u0438\u0441\u0442\u0430."
