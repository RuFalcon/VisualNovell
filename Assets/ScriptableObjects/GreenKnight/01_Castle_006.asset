  backgroundSprite: {fileID: 7457602803753497852, guid: d455227385c9b264eb83c9400c423ae6, type: 3}
  dialogueText: "\u0420\u044B\u0446\u0430\u0440\u0438 \u043C\u043E\u043B\u0447\u0430\u043B\u0438,
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0435 \u043D\u0435\u0447\u0435\u0441\u0442\u0438\u0432\u044B\u043C
    \u0443\u0436\u0430\u0441\u043E\u043C. \u041A\u043E\u0440\u043E\u043B\u044C \u0410\u0440\u0442\u0443\u0440,
    \u043F\u043E\u0431\u0430\u0433\u0440\u043E\u0432\u0435\u0432 \u043E\u0442 \u0433\u043D\u0435\u0432\u0430,
    \u0443\u0436\u0435 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u044B\u0437\u043E\u0432 \u0441\u0430\u043C\u043E\u043C\u0443,
    \u043D\u043E \u0442\u044B \u043E\u043F\u0435\u0440\u0435\u0434\u0438\u043B \u0435\u0433\u043E,
    \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u0432 \u0432\u043F\u0435\u0440\u0435\u0434.
    \u042D\u0442\u043E \u0442\u0432\u043E\u0439 \u0434\u043E\u043B\u0433 - \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
    \u0447\u0435\u0441\u0442\u044C \u043A\u043E\u0440\u043E\u043B\u044F \u0438 \u0434\u0432\u043E\u0440\u0430."
