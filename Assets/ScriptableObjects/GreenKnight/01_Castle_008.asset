  character: {fileID: 0}
  backgroundSprite: {fileID: -796584384203758880, guid: 40758ab047991b147b4f87ee7217e088, type: 3}
  dialogueText: "\u0417\u0435\u043B\u0451\u043D\u044B\u0439 \u0420\u044B\u0446\u0430\u0440\u044C
    \u0437\u043B\u043E\u0432\u0435\u0449\u0435 \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F.
    \u041E\u043D \u0441\u043E\u0448\u0435\u043B \u0441 \u043A\u043E\u043D\u044F,
    \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u0442\u0435\u0431\u0435 \u0441\u0435\u043A\u0438\u0440\u0443
    \u0438, \u043E\u0442\u043A\u0438\u043D\u0443\u0432 \u0437\u0435\u043B\u0451\u043D\u044B\u0435
    \u0432\u043E\u043B\u043E\u0441\u044B, \u043E\u0431\u043D\u0430\u0436\u0438\u043B
    \u0448\u0435\u044E, \u043E\u043F\u0443\u0441\u0442\u0438\u0432\u0448\u0438\u0441\u044C
    \u043D\u0430 \u043E\u0434\u043D\u043E \u043A\u043E\u043B\u0435\u043D\u043E. \u0417\u0430\u043B
    \u0437\u0430\u043C\u0435\u0440 \u0432 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0438.
    \u0412 \u0442\u0432\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445 - \u0442\u044F\u0436\u0435\u043B\u0430\u044F,
    \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0441\u0435\u043A\u0438\u0440\u0430,
    \u0438\u0441\u0442\u043E\u0447\u0430\u044E\u0449\u0430\u044F \u0435\u0434\u0432\u0430
    \u0443\u043B\u043E\u0432\u0438\u043C\u044B\u0439 \u0437\u0430\u043F\u0430\u0445
    \u0441\u044B\u0440\u043E\u0439 \u0437\u0435\u043C\u043B\u0438."
  choices:
  - choiceText: "\u041D\u0430\u043D\u0435\u0441\u0442\u0438 \u0447\u0438\u0441\u0442\u044B\u0439
      \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0443\u0434\u0430\u0440"
    nextNode: {fileID: 11400000, guid: 6cfe52ae9bc3e3346913a1b41d3f9eab, type: 2}
    requiredCondition: 
  - choiceText: "\u0412\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u0443\u0434\u0430\u0440
      \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u0441\u0438\u043B\u0443 \u0438
      \u044F\u0440\u043E\u0441\u0442\u044C"
