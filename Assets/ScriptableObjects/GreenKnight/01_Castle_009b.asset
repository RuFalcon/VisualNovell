  character: {fileID: 0}
  backgroundSprite: {fileID: -796584384203758880, guid: 40758ab047991b147b4f87ee7217e088, type: 3}
  dialogueText: "\u0412 \u0443\u0448\u0430\u0445 \u0442\u0432\u043E\u0438\u0445 \u0440\u0435\u0432\u0451\u0442
    \u043A\u0440\u043E\u0432\u044C. \u042D\u0442\u043E \u043D\u0435 \u0438\u0433\u0440\u0430.
    \u042D\u0442\u043E \u0432\u044B\u0437\u043E\u0432, \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
    \u0442\u0432\u043E\u0435\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u044E, \u0442\u0432\u043E\u0435\u043C\u0443
    \u0434\u043E\u043C\u0443, \u0442\u0432\u043E\u0435\u043C\u0443 \u043E\u0440\u0434\u0435\u043D\u0443.
    \u042D\u0442\u043E \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435, \u043F\u043E\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u044C\u043C\u044B, \u0438 \u043E\u043D\u043E \u0434\u043E\u043B\u0436\u043D\u043E
    \u0431\u044B\u0442\u044C \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043E.
    \u0423\u0447\u0442\u0438\u0432\u043E\u0441\u0442\u044C \u0437\u0434\u0435\u0441\u044C
    \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u0430. \u0422\u044B \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0448\u044C
    \u043C\u044B\u0441\u043B\u0438 \u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445
    \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0422\u044B - \u0432\u043E\u0438\u043D,
    \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0449\u0438\u0439 \u0441\u0432\u043E\u0439
    \u043C\u0438\u0440. \u0422\u044B \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C
    \u0432 \u0443\u0434\u0430\u0440 \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u0441\u0438\u043B\u0443,
    \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u044F\u0440\u043E\u0441\u0442\u044C,
    \u0432\u0441\u0451 \u0441\u0432\u043E\u0451 \u043F\u0440\u0435\u0437\u0440\u0435\u043D\u0438\u0435
    \u043A \u044D\u0442\u043E\u043C\u0443 \u0441\u0432\u0435\u0440\u0445\u044A\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443
    \u0443\u0436\u0430\u0441\u0443. \u0421\u0435\u043A\u0438\u0440\u0430 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435 \u043F\u043B\u0430\u0432\u043D\u043E, \u0430 \u0441 \u0434\u0438\u043A\u0438\u043C
    \u0440\u0451\u0432\u043E\u043C, \u043A\u0430\u043A \u043C\u043E\u043B\u043D\u0438\u044F,
    \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u044E\u0449\u0430\u044F
    \u0434\u0440\u0435\u0432\u043D\u0438\u0439 \u0434\u0443\u0431."
