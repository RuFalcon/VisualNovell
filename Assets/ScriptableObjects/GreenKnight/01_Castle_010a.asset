  backgroundSprite: {fileID: -796584384203758880, guid: 40758ab047991b147b4f87ee7217e088, type: 3}
  dialogueText: "\u0420\u0430\u0437\u0434\u0430\u043B\u0441\u044F \u0433\u043B\u0443\u0445\u043E\u0439,
    \u0432\u043B\u0430\u0436\u043D\u044B\u0439 \u0445\u0440\u0443\u0441\u0442. \u0413\u043E\u043B\u043E\u0432\u0430
    \u0417\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u0420\u044B\u0446\u0430\u0440\u044F
    \u043E\u0442\u0434\u0435\u043B\u0438\u043B\u0430\u0441\u044C \u043E\u0442 \u0442\u0435\u043B\u0430
    \u0438 \u0441 \u0442\u044F\u0436\u0435\u043B\u044B\u043C \u0441\u0442\u0443\u043A\u043E\u043C
    \u0443\u043F\u0430\u043B\u0430 \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
    \u043F\u043B\u0438\u0442\u044B, \u043F\u0440\u043E\u043A\u0430\u0442\u0438\u0432\u0448\u0438\u0441\u044C
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0444\u0443\u0442\u043E\u0432
    \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0438\u0441\u044C
    \u0443 \u043D\u043E\u0433 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u044B \u0413\u0432\u0438\u043D\u0435\u0432\u0440\u044B.
    \u0418\u0437 \u0440\u0430\u043D\u044B \u0445\u043B\u044B\u043D\u0443\u043B\u0430
    \u043A\u0440\u043E\u0432\u044C - \u0433\u0443\u0441\u0442\u0430\u044F \u0438
    \u0442\u0451\u043C\u043D\u0430\u044F, \u043A\u0430\u043A \u0434\u0440\u0435\u0432\u0435\u0441\u043D\u044B\u0439
    \u0441\u043E\u043A. \u041D\u043E \u0442\u0435\u043B\u043E \u043D\u0435 \u0443\u043F\u0430\u043B\u043E."
