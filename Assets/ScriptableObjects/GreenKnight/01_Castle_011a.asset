  backgroundSprite: {fileID: 2668579784341953398, guid: c6e4eb60da8b8a34e9e1794976f3349c, type: 3}
  dialogueText: "\u041A \u0443\u0436\u0430\u0441\u0443 \u0432\u0441\u0435\u0433\u043E
    \u0434\u0432\u043E\u0440\u0430, \u043E\u0431\u0435\u0437\u0433\u043B\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
    \u0444\u0438\u0433\u0443\u0440\u0430 \u0432 \u0437\u0435\u043B\u0451\u043D\u044B\u0445
    \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445 \u043D\u0435 \u043F\u043E\u0448\u0430\u0442\u043D\u0443\u043B\u0430\u0441\u044C.
    \u041E\u043D\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u0448\u0430\u0433,
    \u0437\u0430\u0442\u0435\u043C \u0434\u0440\u0443\u0433\u043E\u0439, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
    \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A \u0441\u0432\u043E\u0435\u0439
    \u043E\u0442\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u0435
    \u0438 \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0435\u0451 \u0437\u0430 \u0432\u043E\u043B\u043E\u0441\u044B.
    \u0418 \u0442\u043E\u0433\u0434\u0430 \u0433\u043E\u043B\u043E\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
    \u0441\u0432\u043E\u0438 \u0431\u0430\u0433\u0440\u043E\u0432\u044B\u0435 \u0433\u043B\u0430\u0437\u0430."
