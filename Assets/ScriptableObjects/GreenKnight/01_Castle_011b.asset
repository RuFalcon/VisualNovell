  dialogueText: "\u041E\u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
    \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043A \u0442\u0435\u0431\u0435. \u0418\u0437 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439
    \u0448\u0435\u0438 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043D\u0435
    \u0433\u043E\u043B\u043E\u0441, \u0430 \u0431\u0443\u043B\u044C\u043A\u0430\u044E\u0449\u0438\u0439,
    \u043A\u043B\u043E\u043A\u043E\u0447\u0443\u0449\u0438\u0439 \u0448\u0451\u043F\u043E\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u0430\u043C\u043E\u0439
    \u0437\u0435\u043C\u043B\u0435 \u043F\u043E\u0434 \u0437\u0430\u043C\u043A\u043E\u043C."
