  backgroundSprite: {fileID: -8306346733814763853, guid: 6d511f4413db8564fa1f3885a587d194, type: 3}
  dialogueText: "\u0421 \u044D\u0442\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438
    \u0442\u0435\u043B\u043E \u0417\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u0420\u044B\u0446\u0430\u0440\u044F
    \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u043E\u0441\u044C \u0432 \u043F\u0440\u0430\u0445
    \u0438 \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u043C\u043E\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0442\u0443\u0442 \u0436\u0435 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B
    \u0441\u043A\u0432\u043E\u0437\u043D\u044F\u043A \u0438 \u0440\u0430\u0437\u0432\u0435\u044F\u043B
    \u043F\u043E \u0437\u0430\u043B\u0443, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
    \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0431\u044F \u043B\u0438\u0448\u044C
    \u0437\u0430\u043F\u0430\u0445 \u0441\u044B\u0440\u043E\u0439 \u043C\u043E\u0433\u0438\u043B\u044B."
  choices: []
  nextNode: {fileID: 0}
  isEnding: 1
  endingText: "\u041F\u0438\u0440 \u043E\u043A\u043E\u043D\u0447\u0435\u043D. \u041D\u043E
    \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u044F \u0436\u0434\u0451\u0442
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u043E\u0434 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F.
