  backgroundSprite: {fileID: -6483732629545066514, guid: c90ed6c3cb1277c4991bab2f355526b1, type: 3}
  dialogueText: "\u0413\u043E\u0434 \u0438 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C\u2026
    \u0421\u0440\u043E\u043A \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u043B, \u043A\u0430\u043A
    \u043E\u0434\u043D\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435,
    \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439 \u0441\u043C\u0435\u043D\u043E\u0439
    \u0441\u0435\u0437\u043E\u043D\u043E\u0432. \u0417\u0438\u043C\u0430 \u0441\u043C\u0435\u043D\u0438\u043B\u0430\u0441\u044C
    \u0432\u0435\u0441\u043D\u043E\u0439, \u043B\u0435\u0442\u043E \u2014 \u043E\u0441\u0435\u043D\u044C\u044E,
    \u0438 \u0432\u043E\u0442 \u0443\u0436\u0435 \u0441\u043D\u043E\u0432\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
    \u0432\u0435\u0442\u0435\u0440 \u0437\u0430\u0432\u044B\u0432\u0430\u0435\u0442
    \u0432 \u0431\u043E\u0439\u043D\u0438\u0446\u0430\u0445 \u041A\u0430\u043C\u0435\u043B\u043E\u0442\u0430.
    \u0417\u0430 \u044D\u0442\u043E\u0442 \u0433\u043E\u0434 \u0442\u0432\u043E\u0439
    \u043F\u043E\u0434\u0432\u0438\u0433 \u0441\u0442\u0430\u043B \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439,
    \u043D\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0441\u0430\u043C\u043E\u0433\u043E
    \u043E\u043D \u0431\u044B\u043B \u043B\u0438\u0448\u044C \u043F\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u0438\u0435\u043C
    \u0443\u0436\u0430\u0441\u0430."
