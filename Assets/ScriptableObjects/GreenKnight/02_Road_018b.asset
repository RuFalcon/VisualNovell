  backgroundSprite: {fileID: 7212713316285918515, guid: 6b89b83a4de942145949c6cbe9d8c488, type: 3}
  dialogueText: "\u0418 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443
    \u043E\u0442 \u041A\u0430\u043C\u0435\u043B\u043E\u0442\u0430, \u043A\u043E\u0433\u0434\u0430
    \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u043B \u043E\u043D \u043F\u043E \u043B\u0435\u0441\u0443,
    \u0432\u0434\u0440\u0443\u0433 \u043F\u043E\u0432\u0430\u043B\u0438\u043B\u043E\u0441\u044C
    \u043D\u0430 \u043D\u0435\u0433\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u043A\u0440\u0435\u043F\u043A\u043E\u0435
    \u0435\u0449\u0435 \u043D\u0430 \u0432\u0438\u0434 \u0434\u0435\u0440\u0435\u0432\u043E,
    \u0441\u0448\u0438\u0431\u043B\u043E \u0441 \u043A\u043E\u043D\u044F \u0438 \u043F\u0435\u0440\u0435\u0431\u0438\u043B\u043E
    \u0440\u044B\u0446\u0430\u0440\u044E \u0448\u0435\u044E - \u043F\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u043C\u0443
    \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044E, \u0432 \u0442\u043E\u043C
    \u0436\u0435 \u0441\u0430\u043C\u043E\u043C \u043C\u0435\u0441\u0442\u0435, \u0432
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0433\u043E\u0434 \u043D\u0430\u0437\u0430\u0434
    \u043D\u0435\u0434\u0440\u043E\u0433\u043D\u0443\u0432\u0448\u0435\u0439 \u0440\u0443\u043A\u043E\u044E
    \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B \u043E\u043D \u0441\u0432\u043E\u0439
    \u0443\u0434\u0430\u0440 \u0417\u0435\u043B\u0435\u043D\u043E\u043C\u0443 \u0420\u044B\u0446\u0430\u0440\u044E."
