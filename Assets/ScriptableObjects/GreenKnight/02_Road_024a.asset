  character: {fileID: 0}
  backgroundSprite: {fileID: 4541941847363498699, guid: d44fb9e02e87a57408e76f371d5b49b0, type: 3}
  dialogueText: "\u0418 \u0442\u043E\u0433\u0434\u0430 \u0442\u044B \u0441\u043B\u044B\u0448\u0438\u0448\u044C
    \u0438\u0445. \u0428\u0451\u043F\u043E\u0442.\r\n\u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u043E\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432\u043E\u0437\u0434\u0443\u0445\u0430,
    \u043F\u043E\u0445\u043E\u0436\u0435\u0435 \u043D\u0430 \u0448\u0435\u043B\u0435\u0441\u0442
    \u0441\u0443\u0445\u0438\u0445 \u043B\u0438\u0441\u0442\u044C\u0435\u0432. \u041D\u043E
    \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0433\u043E\u043B\u043E\u0441\u0430
    \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043E\u0442\u0447\u0451\u0442\u043B\u0438\u0432\u0435\u0435.
    \u041E\u043D\u0438 \u0432\u044C\u044E\u0442\u0441\u044F \u0432\u043E\u043A\u0440\u0443\u0433
    \u0442\u0435\u0431\u044F, \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044F \u0441\u043A\u0432\u043E\u0437\u044C
    \u0448\u043B\u0435\u043C, \u0433\u043E\u0432\u043E\u0440\u044F \u043D\u0430 \u0441\u043E\u0442\u043D\u0438
    \u0440\u0430\u0437\u043D\u044B\u0445 \u043B\u0430\u0434\u043E\u0432. \u042D\u0442\u043E
    \u0433\u043E\u043B\u043E\u0441\u0430 \u0443\u0442\u043E\u043D\u0443\u0432\u0448\u0438\u0445
    \u0437\u0434\u0435\u0441\u044C \u0432\u043E\u0438\u043D\u043E\u0432, \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u0432\u0448\u0438\u0445\u0441\u044F
    \u0434\u0435\u0442\u0435\u0439, \u043E\u0442\u0447\u0430\u044F\u0432\u0448\u0438\u0445\u0441\u044F
    \u0436\u0435\u043D\u0449\u0438\u043D. \u041E\u043D\u0438 \u0448\u0435\u043F\u0447\u0443\u0442
    \u043E \u0442\u0449\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u043F\u0443\u0442\u0438,
    \u043E \u0445\u043E\u043B\u043E\u0434\u0435 \u0441\u043C\u0435\u0440\u0442\u0438,
    \u043E \u0441\u043B\u0430\u0434\u043E\u0441\u0442\u0438 \u043F\u043E\u043A\u043E\u044F
    \u043D\u0430 \u0434\u043D\u0435 \u0442\u0440\u044F\u0441\u0438\u043D\u044B."
