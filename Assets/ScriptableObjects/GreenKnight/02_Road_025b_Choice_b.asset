  dialogueText: "\u0422\u0432\u043E\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430
    \u0441 \u043D\u0435\u0447\u0438\u0441\u0442\u044C\u044E \u0441\u0434\u0435\u043B\u0430\u043B\u0430
    \u0442\u0435\u0431\u044F \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C.
    \u0417\u0430\u043C\u043E\u043A, \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u0439
    \u0438\u0437 \u043D\u0438\u043E\u0442\u043A\u0443\u0434\u0430 - \u044D\u0442\u043E
    \u043B\u043E\u0432\u0443\u0448\u043A\u0430. \u0422\u044B \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0448\u044C
    \u043A\u043E\u043D\u044F \u0438 \u0443\u0433\u043B\u0443\u0431\u043B\u044F\u0435\u0448\u044C\u0441\u044F
    \u0432 \u043B\u0435\u0441, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438
    \u0443\u043A\u0440\u044B\u0442\u0438\u0435 \u043E\u0442 \u043C\u0435\u0442\u0435\u043B\u0438."
