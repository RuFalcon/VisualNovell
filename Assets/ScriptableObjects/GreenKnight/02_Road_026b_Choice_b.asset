  backgroundSprite: {fileID: -5283438160289369506, guid: 79fcc6a37beabc7459e363a682efcd30, type: 3}
  dialogueText: "\u0422\u044B \u0432\u044B\u0436\u0438\u0432\u0430\u0435\u0448\u044C,
    \u043D\u043E \u043A \u0443\u0442\u0440\u0443 \u0442\u044B \u0438 \u0442\u0432\u043E\u0439
    \u043A\u043E\u043D\u044C \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u0431\u0438\u043B\u0438\u0441\u044C \u0438\u0437 \u0441\u0438\u043B.
    \u0422\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F. \u0422\u0435\u043F\u0435\u0440\u044C, \u0447\u0442\u043E\u0431\u044B
    \u0443\u0441\u043F\u0435\u0442\u044C \u043A \u0417\u0435\u043B\u0451\u043D\u043E\u0439
    \u0447\u0430\u0441\u043E\u0432\u043D\u0435 \u0432 \u0441\u0440\u043E\u043A, \u0442\u0435\u0431\u0435
    \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0433\u043D\u0430\u0442\u044C
    \u043A\u043E\u043D\u044F \u0431\u0435\u0437 \u043E\u0442\u0434\u044B\u0445\u0430,
    \u0440\u0438\u0441\u043A\u0443\u044F \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C\u044E
    \u0438 \u0441\u0432\u043E\u0435\u0439."
