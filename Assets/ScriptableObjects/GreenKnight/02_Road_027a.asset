  dialogueText: "\u0418 \u044F \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0431\u044B\u043B
    \u0441\u0432\u044F\u0437\u0430\u043D \u043A\u043B\u044F\u0442\u0432\u043E\u0439.
    \u0418 \u044F \u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437 \u044D\u0442\u0443
    \u0442\u0440\u044F\u0441\u0438\u043D\u0443. \u041D\u043E \u0447\u0435\u0441\u0442\u044C
    - \u0442\u044F\u0436\u0435\u043B\u044B\u0439 \u0433\u0440\u0443\u0437. \u0421\u0431\u0440\u043E\u0441\u044C
    \u0435\u0433\u043E. \u041E\u0441\u0442\u0430\u043D\u044C\u0441\u044F \u0441 \u043D\u0430\u043C\u0438.
    \u0417\u0434\u0435\u0441\u044C \u043D\u0435\u0442 \u043D\u0438 \u0441\u043B\u0430\u0432\u044B,
    \u043D\u0438 \u043F\u043E\u0437\u043E\u0440\u0430. \u0422\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u043A\u043E\u0439."
