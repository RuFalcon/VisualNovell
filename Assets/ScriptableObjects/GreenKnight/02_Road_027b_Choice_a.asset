  dialogueText: "\u041E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0442\u0435\u0431\u0435, \u0447\u0442\u043E \u0417\u0435\u043B\u0451\u043D\u044B\u0439
    \u0420\u044B\u0446\u0430\u0440\u044C - \u044D\u0442\u043E \u043B\u0438\u0448\u044C
    \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0438\u0435, \u0434\u0440\u0435\u0432\u043D\u0435\u0435
    \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u044D\u0442\u0438\u0445 \u0433\u043E\u0440,
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u043D\u044B\u0439
    \u043A\u0443\u043B\u044C\u0442 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
    \u0432 \u0436\u0435\u0440\u0442\u0432\u0443 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432.
    \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0442\u0435\u0431\u0435
    \u043F\u043E\u043C\u043E\u0449\u044C"
