  backgroundSprite: {fileID: 4114143843395068570, guid: 2354e8b5477742a45920a8983f309e59, type: 3}
  dialogueText: "\u0422\u044B \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0448\u044C
    \u0438 \u0440\u0438\u0441\u043A\u0443\u0435\u0448\u044C \u0443\u0432\u044F\u0437\u043D\u0443\u0442\u044C
    \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435. \u041E\u0433\u043E\u043D\u0451\u043A
    \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u0442\u0435\u0431\u044F \u043A
    \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u043E\u043C\u0443 \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u0443,
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u0442\u043E\u0438\u0442
    \u0443\u0431\u043E\u0433\u0430\u044F \u0445\u0438\u0436\u0438\u043D\u0430 \u0438\u0437
    \u0438\u043B\u0430 \u0438 \u043A\u043E\u0441\u0442\u0435\u0439. \u041D\u0430
    \u043F\u043E\u0440\u043E\u0433\u0435 \u0441\u0438\u0434\u0438\u0442 \u0434\u0440\u0435\u0432\u043D\u0438\u0439,
    \u043A\u0430\u043A \u0441\u0430\u043C\u043E \u0431\u043E\u043B\u043E\u0442\u043E,
    \u0441\u0442\u0430\u0440\u0438\u043A."
