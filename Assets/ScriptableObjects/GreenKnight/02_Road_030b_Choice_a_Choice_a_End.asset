  character: {fileID: 0}
  backgroundSprite: {fileID: -3902632097096475235, guid: 73fa2af0b4346dc4592ef5787700646b, type: 3}
  dialogueText: "\u0422\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F \u0434\u043E
    \u0417\u0435\u043B\u0451\u043D\u043E\u0439 \u0447\u0430\u0441\u043E\u0432\u043D\u0438,
    \u043D\u043E \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E \u043F\u043E\u0437\u0436\u0435
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0440\u043E\u043A\u0430.
    \u041A\u0443\u0440\u0433\u0430\u043D \u043F\u0443\u0441\u0442, \u043B\u0438\u0448\u044C
    \u0432\u0435\u0442\u0435\u0440 \u0437\u0430\u0432\u044B\u0432\u0430\u0435\u0442
    \u0432 \u043F\u0443\u0441\u0442\u044B\u0445 \u043F\u0440\u043E\u0451\u043C\u0430\u0445.
    \u0422\u044B \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435.
    \u0422\u044B \u043D\u0430\u0440\u0443\u0448\u0438\u043B \u0441\u043B\u043E\u0432\u043E.
    \u0422\u044B \u0441\u043F\u0430\u0441 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
    \u043D\u043E \u043F\u043E\u0433\u0443\u0431\u0438\u043B \u0441\u0432\u043E\u044E
    \u0440\u044B\u0446\u0430\u0440\u0441\u043A\u0443\u044E \u0447\u0435\u0441\u0442\u044C.
    \u0422\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0432 \u041A\u0430\u043C\u0435\u043B\u043E\u0442. "
  choices: []
  nextNode: {fileID: 0}
  isEnding: 1
  endingText: "\u0422\u0432\u043E\u0451 \u0438\u043C\u044F \u0431\u0443\u0434\u0435\u0442
    \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E. \u0422\u044B \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F
    \u0432 \u0434\u0438\u043A\u0438\u0445 \u0437\u0435\u043C\u043B\u044F\u0445, \u0441\u0442\u0430\u0432
    \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u043C \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u043E\u043C
    \u044D\u0442\u0438\u0445 \u0437\u0430\u0431\u044B\u0442\u044B\u0445 \u0431\u043E\u0433\u043E\u043C
    \u043C\u0435\u0441\u0442."
