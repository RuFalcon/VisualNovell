  backgroundSprite: {fileID: 9168667864131841622, guid: 8f10341397911ca4f8313ce786caca28, type: 3}
  dialogueText: "\u0418 \u0442\u043E\u0433\u0434\u0430 \u0441\u043A\u0432\u043E\u0437\u044C
    \u043F\u0435\u043B\u0435\u043D\u0443 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0435\u0439\u0441\u044F
    \u043C\u0435\u0442\u0435\u043B\u0438 \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C
    \u0435\u0433\u043E. \u0412\u043F\u0435\u0440\u0435\u0434\u0438, \u043D\u0430
    \u0441\u043A\u0430\u043B\u0438\u0441\u0442\u043E\u043C \u0445\u043E\u043B\u043C\u0435,
    \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F \u0437\u0430\u043C\u043E\u043A.
    \u041E\u043D \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0442\u0451\u043C\u043D\u044B\u043C
    \u0438 \u043D\u0435\u043F\u0440\u0438\u0441\u0442\u0443\u043F\u043D\u044B\u043C,
    \u043D\u043E \u0432 \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
    \u043E\u043A\u043E\u043D \u0433\u043E\u0440\u0438\u0442 \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439,
    \u0442\u0451\u043F\u043B\u044B\u0439 \u043E\u0433\u043E\u043D\u0451\u043A - \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435
    \u0442\u0435\u043F\u043B\u0430 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
