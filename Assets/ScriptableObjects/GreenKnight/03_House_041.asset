  dialogueText: "\u0412 \u0434\u0432\u0435\u0440\u044F\u0445 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
    \u0437\u0430\u043B\u0430 \u0442\u0435\u0431\u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
    \u0445\u043E\u0437\u044F\u0438\u043D - \u0447\u0435\u043B\u043E\u0432\u0435\u043A-\u0433\u043E\u0440\u0430,
    \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439, \u0441 \u0433\u0443\u0441\u0442\u043E\u0439
    \u0440\u044B\u0436\u0435\u0439 \u0431\u043E\u0440\u043E\u0434\u043E\u0439 \u0438
    \u0433\u0440\u043E\u043C\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u043C \u0441\u043C\u0435\u0445\u043E\u043C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u043C\u043E\u0433 \u0431\u044B \u0441\u043E\u0442\u0440\u044F\u0441\u0442\u0438
    \u0441\u0442\u0435\u043D\u044B."
