  character: {fileID: 0}
  backgroundSprite: {fileID: 1076240872347416113, guid: 9e6e1131317dec741b76e517d670f288, type: 3}
  dialogueText: "\u0422\u0435\u0431\u044F \u043F\u0440\u043E\u0432\u0435\u043B\u0438
    \u0432 \u0437\u0430\u043B, \u0433\u0434\u0435 \u0440\u0435\u0432\u0435\u043B
    \u043E\u0433\u043E\u043D\u044C \u0432 \u043A\u0430\u043C\u0438\u043D\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
    \u0441 \u043F\u0435\u0449\u0435\u0440\u0443, \u0430 \u043D\u0430 \u0441\u0442\u043E\u043B\u0430\u0445
    \u0443\u0436\u0435 \u0434\u044B\u043C\u0438\u043B\u0438\u0441\u044C \u044F\u0441\u0442\u0432\u0430.
    \u0425\u043E\u0437\u044F\u0438\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B
    \u0442\u0435\u0431\u0435 \u0441\u0432\u043E\u044E \u0436\u0435\u043D\u0443 -
    \u0436\u0435\u043D\u0449\u0438\u043D\u0443 \u0442\u0430\u043A\u043E\u0439 \u043E\u0441\u043B\u0435\u043F\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043A\u0440\u0430\u0441\u043E\u0442\u044B, \u0447\u0442\u043E \u0441\u0430\u043C\u0430
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0430 \u0413\u0432\u0438\u043D\u0435\u0432\u0440\u0430
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0431\u044B \u0440\u044F\u0434\u043E\u043C
    \u0441 \u043D\u0435\u0439 \u0431\u043B\u0435\u0434\u043D\u043E\u0439 \u0442\u0435\u043D\u044C\u044E.
    \u041D\u043E \u0431\u044B\u043B\u0430 \u0432 \u0435\u0451 \u0432\u0437\u0433\u043B\u044F\u0434\u0435
    \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0445\u0438\u0449\u043D\u0430\u044F
    \u0438\u0441\u043A\u0440\u0430, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C \u043D\u0435
    \u043F\u043E \u0441\u0435\u0431\u0435."
