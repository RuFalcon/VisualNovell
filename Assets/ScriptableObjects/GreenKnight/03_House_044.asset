  backgroundSprite: {fileID: 1076240872347416113, guid: 9e6e1131317dec741b76e517d670f288, type: 3}
  dialogueText: "\u0420\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439, \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0438\u0440\u0443\u044F
    \u0441 \u0435\u0451 \u044E\u043D\u043E\u0441\u0442\u044C\u044E, \u0441\u0438\u0434\u0435\u043B\u0430
    \u0434\u0440\u0435\u0432\u043D\u044F\u044F \u0441\u0442\u0430\u0440\u0443\u0445\u0430
    \u0432 \u0447\u0435\u0440\u043D\u043E\u043C, \u0441 \u043B\u0438\u0446\u043E\u043C,
    \u043F\u043E\u0445\u043E\u0436\u0438\u043C \u043D\u0430 \u0432\u044B\u0441\u043E\u0445\u0448\u0438\u0439
    \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442, \u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438-\u0431\u0443\u0441\u0438\u043D\u043A\u0430\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043B\u0435\u0434\u0438\u043B\u0438
    \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u043C \u0442\u0432\u043E\u0438\u043C
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C. \u0422\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
    \u043E \u0441\u0432\u043E\u0435\u0439 \u0446\u0435\u043B\u0438 - \u0417\u0435\u043B\u0451\u043D\u043E\u0439
    \u0447\u0430\u0441\u043E\u0432\u043D\u0435. \u0425\u043E\u0437\u044F\u0438\u043D
    \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F."
