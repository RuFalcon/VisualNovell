  dialogueText: "\u041F\u0443\u0441\u0442\u043E\u0435! \u042D\u0442\u0430 \u0447\u0430\u0441\u043E\u0432\u043D\u044F
    \u0432\u0441\u0435\u0433\u043E \u0432 \u043F\u0430\u0440\u0435 \u043B\u0438\u0433
    \u043E\u0442\u0441\u044E\u0434\u0430. \u0412\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E
