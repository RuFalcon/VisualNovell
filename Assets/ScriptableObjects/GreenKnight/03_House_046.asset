  backgroundSprite: {fileID: 1076240872347416113, guid: 9e6e1131317dec741b76e517d670f288, type: 3}
  dialogueText: "\u0423 \u043C\u0435\u043D\u044F \u0442\u0443\u0442 \u043D\u0435\u0434\u0443\u0440\u043D\u0430\u044F
    \u043E\u0445\u043E\u0442\u0430, \u043D\u043E \u0432\u044B, \u043A\u0430\u043A
    \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C \u0442\u0430\u043A\u0438\u0445
    \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0439. \u0422\u043E\u0433\u0434\u0430
    \u043D\u0430 \u043E\u0445\u043E\u0442\u0443 \u044F \u043F\u043E\u0435\u0434\u0443
    \u043E\u0434\u0438\u043D, \u0430 \u0432\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C
    \u0437\u0434\u0435\u0441\u044C \u0438 \u0434\u0435\u043B\u0438\u0442\u0435 \u0434\u043E\u0441\u0443\u0433
    \u0441 \u043C\u043E\u0435\u0439 \u0436\u0435\u043D\u043E\u0439."
