  backgroundSprite: {fileID: 1076240872347416113, guid: 9e6e1131317dec741b76e517d670f288, type: 3}
  dialogueText: "\u0411\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u044B\u0439
    \u0441\u044D\u0440, \u0432\u0430\u0448\u0430 \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C
    \u043D\u0435 \u0437\u043D\u0430\u0435\u0442 \u0433\u0440\u0430\u043D\u0438\u0446,
    \u0430 \u0432\u0430\u0448\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u0437\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u043E. \u041D\u043E \u044F \u0441\u0432\u044F\u0437\u0430\u043D
    \u0431\u043E\u043B\u0435\u0435 \u0441\u0442\u0430\u0440\u043E\u0439 \u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0439
    \u043A\u043B\u044F\u0442\u0432\u043E\u0439. \u041C\u043E\u0439 \u0434\u0443\u0445
    \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u043F\u043E\u0434\u043E\u0431\u0435\u043D
    \u043A\u043B\u0438\u043D\u043A\u0443, \u0433\u043E\u0442\u043E\u0432\u043E\u043C\u0443
    \u043A \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C\u0443 \u0443\u0434\u0430\u0440\u0443.
    \u0418\u0433\u0440\u044B \u0438 \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F
    \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u0442\u0443\u043F\u0438\u0442\u044C
    \u0435\u0433\u043E \u043E\u0441\u0442\u0440\u043E\u0442\u0443. \u041F\u0440\u043E\u0448\u0443
    \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u044C \u043C\u0435\u043D\u044F, \u043D\u043E
    \u044F \u0434\u043E\u043B\u0436\u0435\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
