  backgroundSprite: {fileID: 1859844586407765182, guid: 7aab062b604f81c4c9dca3cf8870c631, type: 3}
  dialogueText: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
    \u0443\u0442\u0440\u043E, \u0435\u0434\u0432\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u043B\u043E,
    \u0437\u0430\u043C\u043E\u043A \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0441\u044F
    \u0448\u0443\u043C\u043E\u043C. \u041B\u0430\u0439 \u0441\u043E\u0431\u0430\u043A,
    \u0440\u0436\u0430\u043D\u0438\u0435 \u043A\u043E\u043D\u0435\u0439, \u0437\u0432\u0443\u043A\u0438
    \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0438\u0445 \u0440\u043E\u0433\u043E\u0432.
    \u0422\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B \u0445\u043E\u0437\u044F\u0438\u043D\u0430
    \u0434\u043E \u0432\u043E\u0440\u043E\u0442. \u041E\u043D \u0431\u044B\u043B
    \u043F\u043E\u043B\u043E\u043D \u0433\u0440\u0443\u0431\u043E\u0433\u043E, \u043F\u0435\u0440\u0432\u043E\u0431\u044B\u0442\u043D\u043E\u0433\u043E
    \u0432\u0435\u0441\u0435\u043B\u044C\u044F, \u043F\u0440\u0435\u0434\u0432\u043A\u0443\u0448\u0430\u044F
    \u043F\u043E\u0433\u043E\u043D\u044E \u0438 \u043A\u0440\u043E\u0432\u044C. \u041A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0441\u043A\u0440\u044B\u043B\u0441\u044F \u0432 \u043B\u0435\u0441\u0443
    \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u0432\u0438\u0442\u043E\u0439,
    \u0432 \u0437\u0430\u043C\u043A\u0435 \u0432\u043E\u0446\u0430\u0440\u0438\u043B\u0430\u0441\u044C
    \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F, \u0432\u044F\u0437\u043A\u0430\u044F
    \u0442\u0438\u0448\u0438\u043D\u0430."
