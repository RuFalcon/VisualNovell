  dialogueText: "\u041D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0432 \u0437\u0430\u043B\u0435 \u0432\u043E\u0446\u0430\u0440\u0438\u043B\u0430\u0441\u044C
    \u0442\u0438\u0448\u0438\u043D\u0430. \u0413\u0440\u043E\u043C\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0439
    \u0441\u043C\u0435\u0445 \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u0443\u043C\u0435\u0440
    \u0443 \u043D\u0435\u0433\u043E \u0432 \u0433\u043E\u0440\u043B\u0435. \u041E\u043D
    \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0442\u0435\u0431\u044F,
    \u0438 \u0432\u0435\u0441\u0451\u043B\u044B\u0435 \u0438\u0441\u043A\u043E\u0440\u043A\u0438
    \u0432 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445 \u0441\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C
    \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C, \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u043C
    \u0431\u043B\u0435\u0441\u043A\u043E\u043C."
