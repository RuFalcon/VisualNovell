  backgroundSprite: {fileID: -3344438376736983339, guid: 247dd4f6072497548ac824eaeae0e857, type: 3}
  dialogueText: "\u0418\u0437\u043C\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u0434\u043E\u043B\u0433\u0438\u043C
    \u043F\u0443\u0442\u0451\u043C \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C, \u0442\u044B
    \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0432 \u0441\u0432\u043E\u0438
    \u043F\u043E\u043A\u043E\u0438 \u0438 \u043B\u0451\u0433 \u0432 \u043F\u043E\u0441\u0442\u0435\u043B\u044C,
    \u0440\u0435\u0448\u0438\u0432 \u043D\u0430\u0432\u0435\u0440\u0441\u0442\u0430\u0442\u044C
    \u0443\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0439 \u0441\u043E\u043D. \u041D\u043E
    \u0435\u0434\u0432\u0430 \u0442\u0432\u043E\u0438 \u0433\u043B\u0430\u0437\u0430
    \u0437\u0430\u043A\u0440\u044B\u043B\u0438\u0441\u044C, \u0434\u0432\u0435\u0440\u044C
    \u0432 \u0441\u043F\u0430\u043B\u044C\u043D\u044E \u0442\u0438\u0445\u043E \u043E\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044C.
    \u041D\u0430 \u043F\u043E\u0440\u043E\u0433\u0435 \u0441\u0442\u043E\u044F\u043B\u0430
    \u043B\u0435\u0434\u0438 \u0437\u0430\u043C\u043A\u0430."
