  backgroundSprite: {fileID: -3344438376736983339, guid: 247dd4f6072497548ac824eaeae0e857, type: 3}
  dialogueText: "\u041E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043E\u0434\u0435\u0442\u0430
    \u0432 \u043B\u0451\u0433\u043A\u043E\u0435 \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0435
    \u043F\u043B\u0430\u0442\u044C\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043D\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u043E,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u043B\u043E
    \u0435\u0451 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0435
    \u0444\u043E\u0440\u043C\u044B. \u041E\u043D\u0430 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E
    \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A \u0442\u0432\u043E\u0435\u0439
    \u043A\u0440\u043E\u0432\u0430\u0442\u0438 \u0438 \u0441\u0435\u043B\u0430 \u043D\u0430
    \u043A\u0440\u0430\u0439, \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u0442\u0435\u0431\u044F
    \u0441 \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u043E\u0439, \u043F\u043E\u0447\u0442\u0438
    \u0445\u0438\u0449\u043D\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439."
