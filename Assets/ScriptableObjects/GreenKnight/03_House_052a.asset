  dialogueText: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u044D\u0442\u043E \u0441\u0430\u043C
    \u0441\u044D\u0440 \u0413\u0430\u0432\u0435\u0439\u043D, \u043B\u0443\u0447\u0448\u0438\u0439
    \u0438\u0437 \u0440\u044B\u0446\u0430\u0440\u0435\u0439, \u043B\u0435\u0436\u0438\u0442
    \u0437\u0434\u0435\u0441\u044C \u043E\u0434\u0438\u043D \u0438 \u0441\u043F\u0438\u0442?
    \u042F \u043F\u043E\u0439\u043C\u0430\u043B\u0430 \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0443
    \u0442\u043E\u0433\u043E, \u043A\u043E\u0433\u043E \u0436\u0435\u043B\u0430\u044E\u0442
    \u0432\u0441\u0435 \u0434\u0430\u043C\u044B \u0411\u0440\u0438\u0442\u0430\u043D\u0438\u0438.
    \u0418 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0432 \u043C\u043E\u0435\u0439
    \u0432\u043B\u0430\u0441\u0442\u0438"
