  backgroundSprite: {fileID: 4105300471820473215, guid: ccbe31de169824a41bb5a2e8d59399ed, type: 3}
  dialogueText: "\u0422\u044B \u043D\u0435 \u0441\u0434\u0430\u0451\u0448\u044C\u0441\u044F.
    \u041D\u043E\u0447\u044C\u044E \u0442\u044B \u0432\u044B\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0448\u044C
    \u0440\u0435\u0448\u0451\u0442\u043A\u0443 \u0438 \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F
    \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u043F\u043E \u0441\u0442\u0435\u043D\u0435
    \u0431\u0430\u0448\u043D\u0438. \u041D\u043E \u044D\u0442\u043E \u043A\u043E\u043B\u0434\u043E\u0432\u0441\u0442\u0432\u043E.
    \u0421\u0442\u0435\u043D\u0430 \u043F\u043E\u0434 \u0442\u0432\u043E\u0438\u043C\u0438
    \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0433\u043B\u0430\u0434\u043A\u043E\u0439, \u043A\u0430\u043A \u043B\u0451\u0434
    \u0438 \u0442\u044B \u0441\u0440\u044B\u0432\u0430\u0435\u0448\u044C\u0441\u044F
    \u0432\u043D\u0438\u0437. \u0422\u044B \u0432\u044B\u0436\u0438\u0432\u0430\u0435\u0448\u044C,
    \u043D\u043E \u043B\u043E\u043C\u0430\u0435\u0448\u044C \u043D\u043E\u0433\u0443."
  choices: []
  nextNode: {fileID: 0}
  isEnding: 1
  endingText: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0445\u0432\u0430\u0442\u0430\u044E\u0442
    \u0442\u0435\u0431\u044F \u0438 \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
    \u0432 \u043A\u0435\u043B\u044C\u044E. \u0422\u0432\u043E\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430
    \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C."
