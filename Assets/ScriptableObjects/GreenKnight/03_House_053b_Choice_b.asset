  backgroundSprite: {fileID: 2148998041079228298, guid: 101cc06cb3055d844a6557e8316cdb6e, type: 3}
  dialogueText: "\u0422\u044B \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0448\u044C
    \u0441\u0432\u043E\u044E \u0443\u0447\u0430\u0441\u0442\u044C \u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0448\u044C
    \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0434\u043D\u0438
    \u0432 \u043C\u043E\u043B\u0438\u0442\u0432\u0435, \u0433\u043E\u0442\u043E\u0432\u044F
    \u0434\u0443\u0448\u0443 \u043A \u0441\u043C\u0435\u0440\u0442\u0438. \u0422\u0432\u043E\u0451
    \u0441\u043C\u0438\u0440\u0435\u043D\u0438\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442
    \u0442\u0432\u043E\u0438\u0445 \u0442\u044E\u0440\u0435\u043C\u0449\u0438\u043A\u043E\u0432
    \u0441 \u0442\u043E\u043B\u043A\u0443. \u041D\u0430 \u0443\u0442\u0440\u043E
    \u041D\u043E\u0432\u043E\u0433\u043E \u0433\u043E\u0434\u0430 \u0445\u043E\u0437\u044F\u0438\u043D
    \u0437\u0430\u043C\u043A\u0430 \u0441\u0430\u043C \u043E\u0442\u0432\u043E\u0434\u0438\u0442
    \u0442\u0435\u0431\u044F \u0432 \u0417\u0435\u043B\u0451\u043D\u0443\u044E \u0447\u0430\u0441\u043E\u0432\u043D\u044E."
