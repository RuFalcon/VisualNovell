  dialogueText: "\u041D\u0435\u0442. \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
    \u0437\u0434\u0435\u0441\u044C. \u041E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
    \u0432\u044B \u0438\u0441\u043A\u0443\u0441\u043D\u044B \u0432 \u0440\u0435\u0447\u0430\u0445
    \u0438 \u043A\u0443\u0440\u0442\u0443\u0430\u0437\u043D\u044B\u0445 \u0438\u0433\u0440\u0430\u0445.
    \u0422\u0430\u043A \u043F\u043E\u043A\u0430\u0436\u0438\u0442\u0435 \u0436\u0435
    \u043C\u043D\u0435 \u0441\u0432\u043E\u0451 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E.
    \u041D\u0430\u0443\u0447\u0438\u0442\u0435 \u043C\u0435\u043D\u044F \u0442\u043E\u043C\u0443,
    \u043E \u0447\u0451\u043C \u0441\u043B\u0430\u0433\u0430\u044E\u0442 \u043F\u0435\u0441\u043D\u0438."
