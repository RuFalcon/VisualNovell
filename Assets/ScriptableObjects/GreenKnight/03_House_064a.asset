  backgroundSprite: {fileID: -7944779129349031958, guid: 4d1c94b2ae2adb44a9ee62d3cbe98c5e, type: 3}
  dialogueText: "\u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0432
    \u0437\u0430\u043B, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
    \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435 \u043E\u0442 \u043F\u043E\u043A\u043E\u0435\u0432
    \u043B\u0435\u0434\u0438, \u043D\u043E \u043E\u043D\u0430 \u043D\u0430\u0448\u043B\u0430
    \u0442\u0435\u0431\u044F \u0441\u0430\u043C\u0430. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u0435\u0449\u0451 \u0441\u043C\u0435\u043B\u0435\u0435.
    \u041E\u043D\u0430 \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A \u0442\u0435\u0431\u0435,
    \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0437\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u043E
    \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u043E\u0433\u043E\u043D\u044C
    \u0432 \u043A\u0430\u043C\u0438\u043D\u0435, \u0438 \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430
    \u0441\u0432\u043E\u044E \u0440\u0443\u043A\u0443 \u0442\u0435\u0431\u0435 \u043D\u0430
    \u043F\u043B\u0435\u0447\u043E."
