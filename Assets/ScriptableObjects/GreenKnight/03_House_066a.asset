  backgroundSprite: {fileID: -7944779129349031958, guid: 4d1c94b2ae2adb44a9ee62d3cbe98c5e, type: 3}
  dialogueText: "\u0415\u0451 \u0441\u043B\u043E\u0432\u0430 \u0431\u0438\u043B\u0438
    \u0442\u043E\u0447\u043D\u043E \u0432 \u0446\u0435\u043B\u044C. \u0412\u0435\u0441\u044C
    \u0434\u0435\u043D\u044C \u043E\u043D\u0430 \u0432\u0435\u043B\u0430 \u0441\u0432\u043E\u044E
    \u0442\u043E\u043D\u043A\u0443\u044E \u0438\u0433\u0440\u0443, \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u044F
    \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u044E \u043E\u0441\u043D\u043E\u0432\u044B
    \u0442\u0432\u043E\u0435\u0433\u043E \u0440\u044B\u0446\u0430\u0440\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0434\u0435\u043A\u0441\u0430. \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
    \u0447\u0442\u043E \u0432\u044B\u0441\u0448\u0430\u044F \u043A\u0443\u0440\u0442\u0443\u0430\u0437\u043D\u043E\u0441\u0442\u044C
    - \u044D\u0442\u043E \u0441\u043B\u0443\u0436\u0435\u043D\u0438\u0435 \u0434\u0430\u043C\u0435,
    \u0438 \u0447\u0442\u043E, \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044F
    \u0435\u0439, \u0442\u044B \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0448\u044C
    \u043D\u0435 \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u044C, \u0430 \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0435\u0440\u0434\u0438\u0435.
    \u0422\u044B \u0431\u044B\u043B \u0437\u0430\u0436\u0430\u0442 \u0432 \u0442\u0438\u0441\u043A\u0430\u0445."
