  backgroundSprite: {fileID: -7944779129349031958, guid: 4d1c94b2ae2adb44a9ee62d3cbe98c5e, type: 3}
  dialogueText: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0442\u0432\u043E\u0439 \u0434\u043E\u0432\u043E\u0434
    \u043E\u043D\u0430 \u043E\u0431\u0440\u0430\u0449\u0430\u043B\u0430 \u043F\u0440\u043E\u0442\u0438\u0432
    \u0442\u0435\u0431\u044F. \u0422\u044B \u0432\u043E\u0441\u0445\u0432\u0430\u043B\u044F\u043B
    \u0435\u0451 \u043A\u0440\u0430\u0441\u043E\u0442\u0443, \u0430 \u043E\u043D\u0430
    \u043E\u0442\u0432\u0435\u0447\u0430\u043B\u0430, \u0447\u0442\u043E \u044D\u0442\u0430
    \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u0441\u0442\u0440\u0430\u0434\u0430\u0435\u0442
    \u0431\u0435\u0437 \u0442\u0432\u043E\u0435\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F.
    \u0422\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0438
    \u0435\u0451 \u043C\u0443\u0436\u0443, \u0430 \u043E\u043D\u0430 \u0448\u0435\u043F\u0442\u0430\u043B\u0430,
    \u0447\u0442\u043E \u0438\u0441\u0442\u0438\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C
    - \u044D\u0442\u043E \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C \u043B\u044E\u0431\u0432\u0438."
