  backgroundSprite: {fileID: -3212336624116630743, guid: 8960b5a0bc99aa242977d81250c01530, type: 3}
  dialogueText: "\u0415\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0431\u044B\u043B
    \u0432\u0435\u0441\u0451\u043B\u044B\u043C, \u043D\u043E \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
    \u043A\u0440\u0430\u0441\u043D\u044B\u0445 \u0433\u043B\u0430\u0437 \u043F\u043B\u044F\u0441\u0430\u043B\u0438
    \u0437\u043B\u043E\u0432\u0435\u0449\u0438\u0435 \u043E\u0433\u043E\u043D\u044C\u043A\u0438.
    \u0422\u044B \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C \u0441\u0442\u0430\u043D\u0435\u0442 \u0440\u0435\u0448\u0430\u044E\u0449\u0438\u043C.
    \u0417\u0430\u0432\u0442\u0440\u0430 \u043A\u0430\u043D\u0443\u043D \u041D\u043E\u0432\u043E\u0433\u043E
    \u0433\u043E\u0434\u0430. \u041F\u043E\u0441\u043B\u0435\u0437\u0430\u0432\u0442\u0440\u0430
    - \u0442\u0432\u043E\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0441
    \u0417\u0435\u043B\u0451\u043D\u044B\u043C \u0420\u044B\u0446\u0430\u0440\u0435\u043C.
    \u0418 \u043B\u0435\u0434\u0438 \u0437\u0430\u043C\u043A\u0430 \u043D\u0435 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u0441\u044F."
  choices:
  - choiceText: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0437\u0434\u043D\u043E
