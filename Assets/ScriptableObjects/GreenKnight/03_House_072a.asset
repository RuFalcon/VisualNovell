  backgroundSprite: {fileID: 1859844586407765182, guid: 7aab062b604f81c4c9dca3cf8870c631, type: 3}
  dialogueText: "\u0422\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u0440\u0430\u0441\u0441\u0432\u0435\u0442
    \u0441 \u0442\u044F\u0436\u0435\u043B\u044B\u043C \u0441\u0435\u0440\u0434\u0446\u0435\u043C,
    \u043D\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0435\u0448\u0438\u043C\u043E\u0441\u0442\u044C\u044E.
    \u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0434\u0435\u043D\u044C.
    \u0422\u044B \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0448\u044C. \u0425\u043E\u0437\u044F\u0438\u043D
    \u0437\u0430\u043C\u043A\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u044B\u043B
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043E\u0436\u0438\u0432\u043B\u0451\u043D.
    \u041E\u043D \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0441\u044F
    \u043D\u0430 \u0441\u0430\u043C\u0443\u044E \u0445\u0438\u0442\u0440\u0443\u044E
    \u0434\u0438\u0447\u044C - \u043D\u0430 \u043B\u0438\u0441\u0430, \u043A\u043E\u0432\u0430\u0440\u043D\u043E\u0433\u043E
    \u0438 \u043D\u0435\u0443\u043B\u043E\u0432\u0438\u043C\u043E\u0433\u043E."
