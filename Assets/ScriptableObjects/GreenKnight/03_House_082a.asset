  backgroundSprite: {fileID: 5147728788452110793, guid: 2c665b0ad322f4349a9cd44b9c754c3d, type: 3}
  dialogueText: "\u0422\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430
    \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u043F\u043E\u044F\u0441. \u041F\u0435\u0440\u0435\u0434
    \u0442\u0432\u043E\u0438\u043C \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u043C
    \u0432\u0437\u043E\u0440\u043E\u043C \u0432\u0441\u0442\u0430\u043B\u0430 \u0433\u0440\u043E\u043C\u0430\u0434\u043D\u0430\u044F
    \u0441\u0435\u043A\u0438\u0440\u0430, \u043B\u0435\u0434\u044F\u043D\u043E\u0435
    \u043B\u0435\u0437\u0432\u0438\u0435, \u0442\u0432\u043E\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0433\u043E\u043B\u043E\u0432\u0430, \u043A\u0430\u0442\u044F\u0449\u0430\u044F\u0441\u044F
    \u043F\u043E \u043C\u0451\u0440\u0437\u043B\u043E\u0439 \u0437\u0435\u043C\u043B\u0435.
    \u0421\u0442\u0440\u0430\u0445, \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
    \u0438 \u043B\u0438\u043F\u043A\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0442\u044B \u043F\u043E\u0434\u0430\u0432\u043B\u044F\u043B \u0446\u0435\u043B\u044B\u0439
    \u0433\u043E\u0434, \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0438\u0437
    \u0433\u043B\u0443\u0431\u0438\u043D \u0434\u0443\u0448\u0438 \u0438 \u0441\u0445\u0432\u0430\u0442\u0438\u043B
    \u0442\u0435\u0431\u044F \u0437\u0430 \u0433\u043E\u0440\u043B\u043E."
