  backgroundSprite: {fileID: 1859844586407765182, guid: 7aab062b604f81c4c9dca3cf8870c631, type: 3}
  dialogueText: "\u0421\u044D\u0440 \u0413\u0430\u0432\u0435\u0439\u043D \u043F\u0440\u043E\u0432\u0435\u043B
    \u0435\u0449\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
    \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C \u0437\u0430\u043C\u043A\u0430\u0438
    \u0435\u0433\u043E \u043B\u0435\u0434\u0438. \u041F\u043E\u043D\u0430\u0447\u0430\u043B\u0443
    \u043E\u043D \u0435\u0449\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0440\u044B\u0446\u0430\u0440\u044E
    \u043E \u0434\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
    \u0435\u0433\u043E \u0436\u0435\u043D\u044B, \u043D\u043E \u0432\u0441\u0435
    \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u043C\u043E\u0433 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
    - \u0443\u0436 \u0431\u043E\u043B\u044C\u043D\u043E \u0432\u0441\u0435 \u0431\u044B\u043B\u043E
    \u0442\u0438\u0445\u043E, \u0445\u043E\u0440\u043E\u0448\u043E\u0438 \u043F\u0440\u0438\u0441\u0442\u043E\u0439\u043D\u043E."
