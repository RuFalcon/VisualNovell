  backgroundSprite: {fileID: -3326082538407715969, guid: 076dc9a983c97604d8c6158869b8b496, type: 3}
  dialogueText: "\u0418\u0437-\u043F\u043E\u0434 \u0445\u043E\u043B\u043C\u0430 \u0432\u044B\u0448\u0435\u043B
    \u0417\u0435\u043B\u0435\u043D\u044B\u0439 \u0420\u044B\u0446\u0430\u0440\u044C.
    \u041A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0437\u0430 \u0433\u043E\u0434
    \u043E\u043D \u0441\u0442\u0430\u043B \u0435\u0449\u0435 \u0432\u044B\u0448\u0435
    \u0440\u043E\u0441\u0442\u043E\u043C \u0438 \u0435\u0449\u0435 \u0443\u0436\u0430\u0441\u043D\u0435\u0435
    \u043B\u0438\u043A\u043E\u043C - \u0442\u0430\u043A,\u0432\u043E \u0432\u0441\u044F\u043A\u043E\u043C
    \u0441\u043B\u0443\u0447\u0430\u0435, \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u0441\u044D\u0440\u0443 \u0413\u0430\u0432\u0435\u0439\u043D\u0443, \u0438 \u0432\u0440\u044F\u0434
    \u043B\u0438 \u043A\u0442\u043E \u043E\u0431\u0432\u0438\u043D\u0438\u043B \u0431\u044B
    \u0435\u0433\u043E \u0437\u0430 \u043D\u0435\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0442\u0430\u043A\u0438\u0445 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445.
    \u041D\u043E \u0432\u0438\u0434\u0443 \u0440\u044B\u0446\u0430\u0440\u044C \u043D\u0435
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
    \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F, \u0441\u043D\u044F\u043B \u0448\u043B\u0435\u043C\u0438
    \u0441\u043A\u043B\u043E\u043D\u0438\u043B \u0433\u043E\u043B\u043E\u0432\u0443."
