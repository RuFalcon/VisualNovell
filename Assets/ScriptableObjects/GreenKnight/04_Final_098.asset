  dialogueText: "\u0427\u0442\u043E \u0436, \u0432\u043E\u0442 \u044D\u0442\u043E
    \u0443\u0436\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0430. \u0411\u0443\u0434\u044C
    \u0432\u044B \u0442\u0430\u043A\u0438\u043C \u0438 \u043F\u0440\u0435\u0436\u0434\u0435,
    \u0433\u043B\u044F\u0434\u0438\u0448\u044C, \u0438 \u043D\u0435 \u0432\u043B\u044F\u043F\u0430\u043B\u0438\u0441\u044C
    \u0431\u044B \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u044E. \u0415\u0439-\u0431\u043E\u0433\u0443,
    \u044F \u0431\u044B \u043F\u0440\u043E\u0441\u0442\u0438\u043B \u0432\u0430\u0441,
    \u043D\u043E \u0434\u043E\u043B\u0433 - \u0434\u0435\u043B\u043E \u0441\u0432\u044F\u0442\u043E\u0435.
    \u0422\u0430\u043A \u043F\u043B\u0430\u0442\u0438 \u0436\u0435 \u043F\u043E \u0441\u0447\u0435\u0442\u0443,
    \u0441\u044D\u0440 \u0413\u0430\u0432\u0435\u0439\u043D!"
