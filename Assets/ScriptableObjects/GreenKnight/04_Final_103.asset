  backgroundSprite: {fileID: 7929019434041523433, guid: da3f2e8b32723554a8d0d6a446dbfa67, type: 3}
  dialogueText: "\u0413\u043B\u0443\u043F\u0435\u0446, \u043D\u0435\u0443\u0436\u0435\u043B\u0438
    \u044F \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F \u0431\u044B,
    \u0435\u0441\u043B\u0438 \u0431 \u043C\u043D\u0435 \u0438 \u0432\u043F\u0440\u0430\u0432\u0434\u0443
    \u043D\u0443\u0436\u043D\u0430 \u0431\u044B\u043B\u0430 \u0442\u0432\u043E\u044F
    \u0436\u0438\u0437\u043D\u044C? \u042F \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B
    \u043D\u0430 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043D\u0435
    \u0442\u0432\u043E\u044E \u0448\u0435\u044E - \u0442\u0443\u0442 \u043B\u044E\u0434\u0438
    \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B,
    \u0438 \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0437\u0435\u043B\u0435\u043D\u044B\u0439
    \u043F\u043E\u044F\u0441 (\u0442\u0443\u0442 \u0413\u0430\u0432\u0435\u0439\u043D
    \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B \u043E\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438)
    \u043D\u0435 \u0441\u043C\u043E\u0433 \u0431\u044B \u0442\u0435\u0431\u044F \u0441\u043F\u0430\u0441\u0442\u0438:
    \u043E\u043D \u043D\u0438\u0447\u0443\u0442\u044C \u043D\u0435 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0435\u0435
    \u0432\u0435\u0440\u0435\u0432\u043A\u0438 \u0432\u0438\u0441\u0435\u043B\u044C\u043D\u0438\u043A\u0430."
