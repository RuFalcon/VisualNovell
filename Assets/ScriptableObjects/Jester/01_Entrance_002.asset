  backgroundSprite: {fileID: -6122997691436264588, guid: 352ef200ade6bf34dadcd1be0ea20118, type: 3}
  dialogueText: "\u041B\u0438\u0448\u044C \u043E\u0434\u043D\u043E \u0432 \u0436\u0438\u0437\u043D\u0438
    \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E 
    \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C - \u0435\u0433\u043E \u0441\u044B\u043D
    \u0420\u043E\u0431\u0435\u0440\u0442. \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0440\u0435\u0431\u0435\u043D\u043E\u043A \u0420\u0438\u0447\u0430\u0440\u0434\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043C\u043E\u0433 \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C 
    \u043C\u043B\u0430\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u0432\u043E\u0437\u0440\u0430\u0441\u0442.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0435\u043C\u0443 \u0443\u0436\u0435 15,
    \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0433\u043E\u0434\u0430 \u043C\u0430\u043B\u044C\u0447\u0438\u043A
    \u0437\u0430\u0439\u043C\u0435\u0442 \u043C\u0435\u0441\u0442\u043E \u0441\u0432\u043E\u0435\u0433\u043E 
    \u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u044F."
