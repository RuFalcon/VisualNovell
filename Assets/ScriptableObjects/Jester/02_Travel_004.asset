  dialogueText: "\u042E\u043D\u043E\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u044E,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435, \u043D\u0435 \u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \u0431\u0435\u0433\u0430\u0442\u044C \u043F\u043E \u0434\u0432\u043E\u0440\u0446\u0443
    \u0431\u0435\u0437 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0430, \u043D\u043E
    \u0437\u0430 \u0420\u043E\u0431\u0435\u0440\u0442\u043E\u043C  \u0441\u043B\u043E\u0436\u043D\u043E
    \u0443\u0441\u043B\u0435\u0434\u0438\u0442\u044C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043E\u043D \u0447\u0430\u0441\u0442\u043E \u0437\u0430\u0431\u0435\u0433\u0430\u0435\u0442
    \u043A \u0442\u0435\u0431\u0435 \u0432 \u043F\u043E\u043A\u043E\u0438 \u0441
    \u0440\u0430\u043D\u043D\u0435\u0433\u043E \u0443\u0442\u0440\u0430, \u0438 \u043F\u0440\u043E\u0441\u0438\u0442
    \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u044C \u0435\u0433\u043E."
