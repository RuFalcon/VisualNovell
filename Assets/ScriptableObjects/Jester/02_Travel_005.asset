  dialogueText: "\u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C, \u0447\u0442\u043E\u0431\u044B
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u0440\u0438\u043D\u0446
    \u0441\u0442\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u043C,
    \u0430 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B  \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430
    \u0443\u0447\u0438\u043B\u0441\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
    \u0441 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.  \u0422\u0435\u0431\u0435
    \u043D\u0443\u0436\u043D\u043E \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
    \u0435\u0433\u043E."
