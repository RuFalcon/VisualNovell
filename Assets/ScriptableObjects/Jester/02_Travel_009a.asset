  dialogueText: "\u0418 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
    \u0432 \u0442\u0435\u0431\u044F \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u044B,
    \u0438 \u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
    \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043B\u0430\u043A\u0430\u0442\u044C,
    \u0438 \u043A\u0443\u0448\u0430\u0442\u044C  \u043E\u0442\u0431\u0440\u043E\u0441\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0442\u0440\u0430\u043F\u0435\u0437\u044B \u043A\u043E\u0440\u043E\u043B\u044F?
    \u0425\u043E\u0440\u043E\u0448\u0438\u0435 \u0436\u0435 \u0443 \u0442\u0435\u0431\u044F
    \u0430\u043C\u0431\u0438\u0446\u0438\u0438! "
