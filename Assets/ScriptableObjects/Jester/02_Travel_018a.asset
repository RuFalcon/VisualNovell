  backgroundSprite: {fileID: -3103704450852416222, guid: 2bd72f5af5f16c344af74340c555cbde, type: 3}
  dialogueText: "\u041C\u0430\u0442\u0443\u0448\u043A\u0430-\u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0430
    \u043C\u043E\u043B\u0447\u0430 \u0441\u043B\u0443\u0448\u0430\u043B\u0430 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0441\u044B\u043D\u0430. \u041E\u043D\u0430, \u043A\u0430\u043A \u0438 \u0442\u044B,
    \u043D\u0435\u0440\u0435\u0434\u043A\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u043B\u0430
    \u0443 \u0441\u0432\u043E\u0435\u0433\u043E  \u0440\u0435\u0431\u0435\u043D\u043A\u0430
    \u043B\u044E\u0431\u043E\u0432\u044C \u043A \u043D\u0430\u0441\u0438\u043B\u0438\u044E,
    \u043D\u043E \u043D\u0435 \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E
    \u0441 \u044D\u0442\u0438\u043C \u0434\u0435\u043B\u0430\u0442\u044C"
