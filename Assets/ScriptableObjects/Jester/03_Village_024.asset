  backgroundSprite: {fileID: -8725089844106830028, guid: 663c6012260b23b4fb80efba2ccc0505, type: 3}
  dialogueText: "\u041A\u043E\u0440\u043E\u043B\u044C \u0420\u0438\u0447\u0430\u0440\u0434
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u044B\u0435\u0437\u0436\u0430\u043B
    \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
    \u043E\u0431\u044B\u0447\u043D\u043E \u043B\u044E\u0434\u0438 \u0441\u0430\u043C\u0438
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438 \u043A \u043D\u0435\u043C\u0443
    \u0432\u043E \u0434\u0432\u043E\u0440\u0435\u0446 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\u044E,
    \u0430 \u0435\u0449\u0435 \u0447\u0430\u0449\u0435 - \u043E\u0431\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C
    \u043A \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u0430\u043C, \u043D\u0435
    \u0441\u043C\u0435\u044F \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C
    \u043A\u043E\u0440\u043E\u043B\u044F \u043F\u043E \u043F\u0443\u0441\u0442\u044F\u043A\u0430\u043C. "
