  dialogueText: "\u0412\u0430\u0448\u0435 \u0432\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E!
    \u0412 \u043D\u0430\u0448\u0435\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u0441\u0442\u043E\u0438\u0442 \u0446\u0435\u0440\u043A\u043E\u0432\u044C,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043D\u0430\u043B\u043E\u0433.
    \u041D\u043E \u0443 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
    \u0438\u0437 \u043D\u0430\u0441 \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
    \u043C\u043E\u043D\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u043A \u0437\u0438\u043C\u043E\u0432\u043A\u0435! "
