  dialogueText: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u0434\u043B\u044F \u043D\u0430\u0441
    \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u0435 \u043B\u044E\u0434\u0435\u0439
    \u0432 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0435. \u0417\u0438\u043C\u0430
    - \u0442\u044F\u0436\u0435\u043B\u043E\u0435 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435,
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0442\u044C
    \u0435\u0433\u043E, \u043D\u0435 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044F
    \u043D\u0430\u043B\u043E\u0433\u0438. \u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u0447\u0442\u043E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
    \u0433\u043E\u0434\u0443 \u0443 \u0432\u0430\u0441 \u0431\u0443\u0434\u0435\u0442
    \u0443\u0434\u0430\u0447\u043D\u044B\u0439 \u0443\u0440\u043E\u0436\u0430\u0439"
