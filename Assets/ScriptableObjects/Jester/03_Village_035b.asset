  backgroundSprite: {fileID: -8725089844106830028, guid: 663c6012260b23b4fb80efba2ccc0505, type: 3}
  dialogueText: "\u041A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0435 \u0437\u0430\u0443\u043B\u044B\u0431\u0430\u043B\u0438\u0441\u044C
    - \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0435 \u043F\u043E\u043D\u044F\u043B\u0438,
    \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442
    \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u044E\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u043D\u0446\u0430. \u0414\u0435\u0442\u0438 \u0436\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0433\u043B\u044F\u0434\u0435\u043B\u0438 \u043D\u0430 \u043D\u0435\u0433\u043E
    \u0441 \u0448\u0438\u0440\u043E\u043A\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044B\u043C\u0438
    \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u042D\u0442\u043E\u0442 \u043C\u0430\u043B\u044C\u0447\u0438\u043A
    \u0447\u0443\u0442\u044C \u0441\u0442\u0430\u0440\u0448\u0435 \u0438\u0445, \u0430
    \u0443\u0436\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0430\u0436\u043D\u044B\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0432\u043B\u0438\u044F\u0442\u044C
    \u043D\u0430 \u0438\u0445 \u0436\u0438\u0437\u043D\u044C. \u041D\u0438\u0447\u0435\u0433\u043E
    \u0441\u0435\u0431\u0435!"
