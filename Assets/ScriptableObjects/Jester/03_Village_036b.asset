  backgroundSprite: {fileID: -8725089844106830028, guid: 663c6012260b23b4fb80efba2ccc0505, type: 3}
  dialogueText: "\u042F! \u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E
    \u043F\u043E\u043A\u0430 \u0447\u0442\u043E \u043A\u0430\u0437\u043D\u0430 \u0432\u043F\u043E\u043B\u043D\u0435
    \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0436\u0438\u0442\u044C \u0431\u0435\u0437
    \u0434\u0435\u043D\u0435\u0433 \u0432\u0430\u0448\u0435\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438.
    \u0412\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C
    \u0442\u044F\u0436\u0435\u043B\u0443\u044E \u0437\u0438\u043C\u0443 - \u0438
    \u044D\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0435\u0440\u0432\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u0430\u044F
    \u0437\u0430\u0434\u0430\u0447\u0430. \u0427\u0442\u043E \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430\u043B\u043E\u0433\u0430 - \u043C\u044B \u0434\u0430\u0435\u043C
    \u0432\u0430\u043C \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0443 \u0434\u043E
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043E\u0441\u0435\u043D\u0438,
    \u0434\u043E \u043D\u043E\u0432\u043E\u0433\u043E \u0443\u0440\u043E\u0436\u0430\u044F.
    \u041D\u043E \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0441\u0440\u043E\u043A!"
