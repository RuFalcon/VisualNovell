  backgroundSprite: {fileID: -8725089844106830028, guid: 663c6012260b23b4fb80efba2ccc0505, type: 3}
  dialogueText: "\u0413\u043E\u043B\u043E\u0434 - \u044D\u0442\u043E \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u043D\u0435
    \u0445\u043E\u0447\u0435\u0448\u044C \u0435\u0441\u0442\u044C. \u042D\u0442\u043E
    \u0434\u043D\u0438 \u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u0431\u0435\u0437
    \u043A\u0440\u043E\u0448\u043A\u0438 \u0445\u043B\u0435\u0431\u0430 \u0432\u043E
    \u0440\u0442\u0443. \u041C\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0433\u0434\u0430 \u0437\u0430 \u043A\u0443\u0441\u043E\u0447\u0435\u043A
    \u043C\u044F\u0441\u0430 \u0433\u043E\u0442\u043E\u0432 \u043E\u0442\u0434\u0430\u0442\u044C
    \u0432\u0441\u0435. \u041A\u043E\u0440\u043E\u043B\u044F\u043C \u044D\u0442\u043E
    \u0441\u043B\u043E\u0432\u043E \u0447\u0442\u043E \u043F\u0443\u0441\u0442\u043E\u0439
    \u0437\u0432\u0443\u043A, \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0430\u043C
    \u0436\u0435 - \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440."
  choices:
  - choiceText: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043D\u0435 \u0435\u0441\u0442\u044C
      \u0434\u0432\u0430 \u0434\u043D\u044F. \u0421\u043C\u043E\u0436\u0435\u0448\u044C?"
