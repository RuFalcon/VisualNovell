  character: {fileID: 0}
  backgroundSprite: {fileID: 1843875127110103885, guid: d5207f5a0fc400d4882b5a640f477fd1, type: 3}
  dialogueText: "\u041C\u0430\u043B\u044C\u0447\u0438\u043A \u0441 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E
    \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F. \u0414\u043B\u044F
    \u043D\u0435\u0433\u043E \u044D\u0442\u043E - \u0432\u0435\u0441\u0435\u043B\u0430\u044F
    \u0438\u0433\u0440\u0430. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0433\u043E\u043B\u043E\u0434\u0430
    \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442,
    \u0435\u0441\u043B\u0438 \u0435\u0448\u044C \u0442\u0440\u0438\u0436\u0434\u044B
    \u0432 \u0434\u0435\u043D\u044C \u0434\u043E \u043E\u0442\u0432\u0430\u043B\u0430.
    \u0422\u044B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
    \u043E\u0431 \u044D\u0442\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C
    \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0435 \u0441
    \u041C\u0430\u0442\u0438\u043B\u044C\u0434\u043E\u0439. \u041E\u043D\u0430 \u043F\u043E\u0447\u0442\u0438
    \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432:\u0422\u043E\u043B\u044C\u043A\u043E
    \u043D\u0435 \u0434\u0430\u0439 \u0435\u043C\u0443 \u0443\u043C\u0435\u0440\u0435\u0442\u044C
    \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430! \u0415\u0441\u043B\u0438 \u043E\u043D
    \u043E\u0442\u043A\u0430\u0436\u0435\u0442\u0441\u044F - \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0439\u0442\u0435
    \u044D\u0442\u0443 \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E \u0438\u0433\u0440\u0443."
