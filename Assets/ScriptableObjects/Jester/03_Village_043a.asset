  backgroundSprite: {fileID: -5300698616080394933, guid: 6e5b639a85b52af45adb3a464d2dd0a2, type: 3}
  dialogueText: "\u0418\u0442\u0430\u043A, \u0420\u043E\u0431\u0435\u0440\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
    \u043E\u0431\u0435\u0434, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0432\u043F\u0435\u0440\u0432\u044B\u0435
    \u0432 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438. \u041E\u043D
    \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043C\u043E\u043B\u043E\u0434\u0446\u043E\u043C,
    \u043C\u043E\u043B\u0447\u0430 \u043F\u0440\u043E\u0433\u043B\u0430\u0442\u044B\u0432\u0430\u044F
    \u0441\u043B\u044E\u043D\u0443 - \u0432\u043E \u0434\u0432\u043E\u0440\u0446\u0435
    \u043D\u0430 \u043E\u0431\u0435\u0434 \u043F\u043E\u0434\u0430\u044E\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043C\u044B\u0435 \u043B\u0443\u0447\u0448\u0438\u0435
    \u0438 \u0441\u0432\u0435\u0436\u0438\u0435 \u0431\u043B\u044E\u0434\u0430. \u0421
    \u0443\u0436\u0438\u043D\u043E\u043C \u0431\u044B\u043B\u043E \u0441\u043B\u043E\u0436\u043D\u0435\u0435
    - \u043C\u0430\u043B\u044C\u0447\u0438\u043A \u0445\u043E\u0442\u0435\u043B \u0435\u0441\u0442\u044C,
    \u043D\u043E \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u0430
    \u0435\u043C\u0443 \u0441\u0434\u0430\u0442\u044C\u0441\u044F. \u0422\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
    \u0447\u0442\u043E \u0443 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430 \u0443\u043F\u0430\u043B\u043E
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 - \u044F\u0432\u043D\u043E
    \u0438\u0437-\u0437\u0430 \u043D\u0435\u0434\u043E\u0435\u0434\u0430\u043D\u0438\u044F"
