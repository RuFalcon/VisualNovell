  backgroundSprite: {fileID: -5300698616080394933, guid: 6e5b639a85b52af45adb3a464d2dd0a2, type: 3}
  dialogueText: "\u041D\u0430 \u043A\u0443\u0445\u043D\u0435 \u043F\u0430\u0440\u0435\u043D\u044C
    \u0442\u0435\u0431\u044F \u0443\u0434\u0438\u0432\u0438\u043B: \u043E\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043E\u0442 \u0440\u043E\u0441\u043A\u043E\u0448\u043D\u043E\u0433\u043E \u0441\u044B\u0442\u043D\u043E\u0433\u043E
    \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430 \u0441\u043E \u0441\u043B\u043E\u0432\u0430\u043C\u0438
    \u0431\u0435\u0434\u043D\u044F\u043A\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
    \u0441\u0435\u0431\u0435 \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C,
    \u0430 \u043C\u044B \u0435\u0434\u0438\u043C \u043A\u0430\u0436\u0434\u044B\u0439
    \u0434\u0435\u043D\u044C! \u041F\u043E\u0437\u0436\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u044B\u0439
    \u043F\u0440\u0438\u043D\u0446 \u0432\u0441\u0435 \u0447\u0430\u0449\u0435 \u0441\u0442\u0430\u043B
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u0431\u043E\u043B\u0435\u0435
    \u0441\u043A\u0440\u043E\u043C\u043D\u0443\u044E \u043F\u0438\u0449\u0443, \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F,
    \u043A\u0430\u043A \u043D\u0435 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F
    \u0438 \u0434\u0432\u0443\u0445 \u0434\u043D\u0435\u0439 \u0431\u0435\u0437 \u0435\u0434\u044B,
    \u0430 \u0431\u0435\u0434\u043D\u044B\u0435 \u0434\u0435\u0442\u0438 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044F\u0445
    \u0433\u043E\u043B\u043E\u0434\u0430\u044E\u0442 \u043D\u0435\u0434\u0435\u043B\u044F\u043C\u0438."
