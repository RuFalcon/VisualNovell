  backgroundSprite: {fileID: 3557628989793662983, guid: 087e919d8b471c240bc9bc6e346d1147, type: 3}
  dialogueText: "\u0420\u043E\u0431\u0435\u0440\u0442 \u043F\u0440\u044B\u0433\u0430\u043B
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0435\u0431\u044F \u0438 \u0432\u0435\u0441\u0435\u043B\u0438\u043B\u0441\u044F.
    \u041E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u043B\u044E\u0431\u0438\u043B
    \u044D\u0442\u043E \u0434\u0435\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435
    \u0431\u0430\u043B\u043E\u0432 \u0438 \u043F\u0438\u0440\u043E\u0432, \u043A\u0430\u043A
    \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
    \u0434\u0435\u0442\u0438. \u041A\u0430\u0437\u043D\u0438 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C, \u0447\u044C\u0438 \u0440\u043E\u0434\u043D\u044B\u0435
    \u0438\u043B\u0438 \u043B\u044E\u0431\u0438\u043C\u044B\u0435 \u0443\u0436\u0435
    \u043F\u043E\u0431\u044B\u0432\u0430\u043B\u0438 \u043D\u0430 \u043F\u043B\u0430\u0445\u0435.
    \u041A\u0430\u043A \u0436\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0435, \u0447\u0442\u043E \u0447\u0443\u0436\u0430\u044F
    \u0441\u043C\u0435\u0440\u0442\u044C \u044D\u0442\u043E \u043D\u0435 \u0442\u0430\u043A
    \u0443\u0436 \u0438 \u0432\u0435\u0441\u0435\u043B\u043E?"
  choices:
  - choiceText: "\u042D\u0442\u043E \u043D\u0435 \u0434\u043B\u044F \u0434\u0435\u0442\u0441\u043A\u0438\u0445
      \u0433\u043B\u0430\u0437"
    nextNode: {fileID: 11400000, guid: e617d403f0438a24a913edc485766e71, type: 2}
  - choiceText: "\u041F\u043E\u0439\u0442\u0438 \u0441 \u043F\u0430\u0440\u043D\u0435\u043C
