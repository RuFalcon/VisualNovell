  dialogueText: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C, \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u043F\u0430\u043B\u0430\u0447. \u042D\u0442\u043E \u0442\u0430\u043A... \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E.
    \u042F \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B \u0431\u044B\u0442\u044C
    \u0448\u0443\u0442\u043E\u043C, \u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
    \u043C\u043D\u0435 \u0441\u0442\u0430\u0442\u044C \u043F\u0430\u043B\u0430\u0447\u043E\u043C?"
