    \u0421\u0432\u043E\u0438\u043C \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u043C
    \u0441\u043B\u043E\u0432\u043E\u043C \u044F \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u044E
    \u0442\u0435\u0431\u0435 \u0432\u043E\u0440\u043E\u0432\u0430\u0442\u044C \u044F\u0431\u043B\u043E\u043A\u0438.
