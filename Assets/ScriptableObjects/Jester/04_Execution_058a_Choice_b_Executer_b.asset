  dialogueText: "\u041A\u0430\u0440\u043B, \u044F \u0431\u044B \u043E\u0442\u0440\u0443\u0431\u0438\u043B
    \u0442\u0435\u0431\u0435 \u0433\u043E\u043B\u043E\u0432\u0443, \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
