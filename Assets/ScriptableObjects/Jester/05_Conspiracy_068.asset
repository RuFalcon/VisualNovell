  backgroundSprite: {fileID: 1147739173082670536, guid: 26d0854f91dc4da4da7d610c68a94cb7, type: 3}
  dialogueText: "\u041C\u043D\u043E\u0433\u0438\u0435 \u0436\u0438\u0442\u0435\u043B\u0438
    \u0434\u0432\u043E\u0440\u0446\u0430 \u0437\u0430\u043F\u0443\u0433\u0430\u043D\u044B.
    \u0418\u0437 \u043F\u043E\u0434\u0432\u0430\u043B\u0430 \u043F\u043E \u043D\u043E\u0447\u0430\u043C
    \u0434\u043E\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u0436\u0435\u043D\u0441\u043A\u0438\u0435
    \u043A\u0440\u0438\u043A\u0438. \u041E\u0434\u043D\u0430\u043A\u043E \u0434\u0432\u0435\u0440\u0438
    \u0432 \u043F\u043E\u0434\u0432\u0430\u043B \u0437\u0430\u043F\u0435\u0440\u0442\u044B,
    \u0432\u043E\u0437\u043B\u0435 \u043D\u0438\u0445 \u0441\u0442\u043E\u0438\u0442
    \u0432\u0435\u0440\u043D\u0430\u044F \u0434\u0440\u0443\u0436\u0438\u043D\u0430
    \u043A\u043E\u0440\u043E\u043B\u044F - \u0420\u043E\u0431\u0435\u0440\u0442 \u0441\u043E\u0431\u0440\u0430\u043B
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F \u043A\u0440\u0435\u043F\u043A\u0438\u0445
    \u043D\u0430\u0435\u043C\u043D\u0438\u043A\u043E\u0432. \u041E\u043D\u0438 \u0441\u043B\u0430\u0432\u044F\u0442\u0441\u044F
    \u043F\u043E\u043B\u043D\u044B\u043C \u0445\u043B\u0430\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u0438\u0435\u043C
    \u0438 \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C\u044E \u0445\u043E\u0437\u044F\u0438\u043D\u0443
    - \u0435\u0441\u043B\u0438 \u043E\u043D \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E
    \u043F\u043B\u0430\u0442\u0438\u0442"
