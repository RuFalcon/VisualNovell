  backgroundSprite: {fileID: 1147739173082670536, guid: 26d0854f91dc4da4da7d610c68a94cb7, type: 3}
  dialogueText: "\u0422\u044B \u0434\u043E\u0433\u0430\u0434\u044B\u0432\u0430\u043B\u0441\u044F,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0432\u043D\u0438\u0437\u0443, \u043D\u043E \u043D\u0438\u043A\u0430\u043A \u043D\u0435
    \u043C\u043E\u0433 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u043F\u043E\u0431\u043B\u0438\u0436\u0435. \u0420\u043E\u0431\u0435\u0440\u0442\u0430
    \u0442\u044B \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C \u043D\u0435
    \u0440\u0435\u0448\u0430\u043B\u0441\u044F: \u043C\u0430\u043B\u044C\u0447\u0438\u043A
    \u0432\u043E\u0437\u043C\u0443\u0436\u0430\u043B \u0437\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u0435\u0441\u044F\u0446\u0435\u0432, \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
    \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044E\u0449\u0443\u044E\u0441\u044F
    \u0432\u043B\u0430\u0441\u0442\u044C. \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D
    \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B \u0441 \u0441\u043E\u0431\u043E\u0439
    \u0441\u044E\u0441\u044E\u043A\u0430\u0442\u044C\u0441\u044F \u0438\u043B\u0438
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u0435\u0431\u044F."
