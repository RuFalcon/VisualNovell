  backgroundSprite: {fileID: 1147739173082670536, guid: 26d0854f91dc4da4da7d610c68a94cb7, type: 3}
  dialogueText: "\u041D\u0430\u0435\u043C\u043D\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
    \u0441 \u043A\u0430\u043A\u0438\u043C-\u0442\u043E \u0436\u0443\u0442\u043A\u043E\u0432\u0430\u0442\u044B\u043C
    \u043E\u0441\u043A\u0430\u043B\u043E\u043C. \u0422\u0435\u0431\u0435 \u0441\u0442\u0430\u043B\u043E
    \u043D\u0435 \u043F\u043E \u0441\u0435\u0431\u0435. \u0422\u0435\u0431\u044F
    \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0437\u0430 \u0440\u0443\u043A\u0443
    \u0438 \u043F\u043E\u0432\u043E\u043B\u043E\u043A\u043B\u0438 \u0432 \u043F\u043E\u0434\u0432\u0430\u043B.
    \u0422\u044B \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C \u0438\u0437-\u0437\u0430 \u043F\u043B\u043E\u0445\u043E\u0433\u043E
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u044F, \u043D\u043E \u043E\u0445\u0440\u0430\u043D\u0430
    \u043A\u043E\u0440\u043E\u043B\u044F \u043D\u0435\u043F\u043B\u043E\u0445\u043E
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0432 \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435."
