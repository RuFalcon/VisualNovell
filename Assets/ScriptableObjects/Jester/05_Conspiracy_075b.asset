  character: {fileID: 0}
  backgroundSprite: {fileID: 1147739173082670536, guid: 26d0854f91dc4da4da7d610c68a94cb7, type: 3}
  dialogueText: "\u041D\u0430\u0435\u043C\u043D\u0438\u043A\u0438 \u043A\u0430\u043A
    \u0431\u044B \u043D\u0435\u0432\u0437\u043D\u0430\u0447\u0430\u0439 \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B\u0438
    \u043A\u043B\u0438\u043D\u043A\u0438. \u0422\u044B \u043F\u043E\u0441\u043F\u0435\u0448\u0438\u043B
    \u0443\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u0442\u0443\u0434\u0430.
    \u041F\u043E\u0434\u0432\u0430\u043B... \u0416\u0443\u0442\u043A\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E, \u043E\u0442\u043A\u0443\u0434\u0430 \u0440\u0430\u0437\u0434\u0430\u044E\u0442\u0441\u044F
    \u0436\u0435\u043D\u0441\u043A\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u0430.
    \u041B\u044E\u0434\u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u044B, \u043A\u043E\u0440\u043E\u043B\u044C
    \u044F\u0432\u043D\u043E \u0437\u0430\u043C\u0435\u0448\u0430\u043D \u0432 \u044D\u0442\u043E\u043C
    \u0434\u0435\u043B\u0435, \u0435\u0433\u043E \u043C\u0430\u0442\u044C... \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
    \u043E\u043D\u0430 \u0441\u043C\u0438\u0440\u0438\u043B\u0430\u0441\u044C \u0441
    \u0442\u0435\u043C, \u0447\u0442\u043E \u0435\u0435 \u0441\u044B\u043D \u0431\u0443\u0434\u0435\u0442
    \u0442\u0438\u0440\u0430\u043D\u043E\u043C. \u0415\u0441\u0442\u044C \u0435\u0449\u0435
    \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0442\u043E\u0436\u0435 \u0432\u0435\u0434\u0443\u0442 \u0441\u0435\u0431\u044F
    \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0441\u043A\u0440\u044B\u0442\u043D\u043E.
    \u041E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
    \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0443 \u0441\u043E \u0432\u0441\u0435\u043C\u0438
    \u0434\u0435\u043B\u0430\u043C\u0438, \u043D\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
    \u0435\u0433\u043E \u043D\u0430 \u043F\u0443\u0442\u044C \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0439."
