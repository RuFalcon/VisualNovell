  backgroundSprite: {fileID: 6625844592777880526, guid: d4d5df860ffd6504fb0d753a958b4825, type: 3}
  dialogueText: "\u0422\u0432\u043E\u0439 \u0420\u043E\u0431\u0435\u0440\u0442, \u0442\u0432\u043E\u0439
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u0440\u0438\u043D\u0446
    - \u0441\u0442\u043E\u0438\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u0441
    \u043E\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0439 \u043F\u043B\u0435\u0442\u043A\u043E\u0439
    \u0432 \u0440\u0443\u043A\u0435. \u0437\u0430 \u043D\u0438\u043C \u043F\u044B\u043B\u0430\u044E\u0442
    \u0444\u0430\u043A\u0435\u043B\u044B, \u043E\u0441\u0432\u0435\u0449\u0430\u044F
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0435\u0435
    \u043A\u0430\u043C\u0435\u0440\u0443 \u043F\u044B\u0442\u043E\u043A. \u0412\u043E
    \u0432\u0440\u0435\u043C\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0420\u0438\u0447\u0430\u0440\u0434 \u0437\u0430\u043F\u0440\u0435\u0442\u0438\u043B
    \u0432\u0441\u0435 \u044D\u0442\u043E, \u0437\u0430\u043C\u0443\u0440\u043E\u0432\u0430\u043B
    \u0432\u0441\u0435 \u043F\u044B\u0442\u043E\u0447\u043D\u044B\u0435. \u041A\u0430\u043A
    \u0436\u0435 \u0420\u043E\u0431\u0435\u0440\u0442 \u0441\u043C\u043E\u0433 \u0438\u0445
    \u043D\u0430\u0439\u0442\u0438?"
