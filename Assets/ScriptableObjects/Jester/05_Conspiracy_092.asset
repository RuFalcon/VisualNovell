  backgroundSprite: {fileID: 6625844592777880526, guid: d4d5df860ffd6504fb0d753a958b4825, type: 3}
  dialogueText: "\u042D\u0442\u0430 \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u043A\u0430
    \u0432\u043E\u0440\u043E\u0432\u043A\u0430... \u0414\u043E \u043D\u0435\u0435
    \u0431\u044B\u043B\u0430 \u0443\u0431\u0438\u0439\u0446\u0430, \u0437\u0430\u0434\u0443\u0448\u0438\u0432\u0448\u0430\u044F
    \u0441\u0432\u043E\u0435\u0433\u043E \u043C\u0443\u0436\u0430. \u0414\u043E \u044D\u0442\u043E\u0433\u043E
    - \u043D\u0430\u0448\u0430 \u0441\u043B\u0443\u0436\u0430\u043D\u043A\u0430,
    \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0448\u043B\u0438
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0435
    \u043F\u0440\u0438\u0431\u043E\u0440\u044B. \u0412\u0438\u0434\u0438\u0448\u044C,
    \u041A\u0430\u0440\u043B, \u044F \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u044E
    \u043D\u0435\u0432\u0438\u043D\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439!
    \u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0445, \u043A\u0442\u043E \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0442
    \u043A\u0430\u0440\u044B."
