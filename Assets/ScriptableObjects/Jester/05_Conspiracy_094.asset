  m_Name: 05_Conspiracy_094
  m_EditorClassIdentifier: 
  character: {fileID: 11400000, guid: ee96a3424bce6a14493fc12602d79534, type: 2}
  backgroundSprite: {fileID: 6625844592777880526, guid: d4d5df860ffd6504fb0d753a958b4825, type: 3}
  dialogueText: "\u041D\u0435\u0442, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u044F \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E \u043E\u0442 \u044D\u0442\u043E\u0433\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F.
    \u041D\u043E \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0439 \u043A\u0430\u0437\u043D\u0438
    \u044F \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F... \u0427\u0442\u043E
    \u0441\u043C\u0435\u0440\u0442\u044C \u044D\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u043E\u0435 \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435
    \u0434\u043B\u044F \u043D\u0430\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u0439
    \u0437\u0430\u043A\u043E\u043D\u0430. \u042F \u0445\u043E\u0447\u0443 \u0431\u044B\u0442\u044C
    \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043A\u043E\u0440\u043E\u043B\u0435\u043C,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0440\u0435\u0434\u0438 \u043D\u0430\u0448\u0438\u0445
    \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u043E\u0440\u043E\u0432
    \u0438 \u0443\u0431\u0438\u0439\u0446."
  choices:
  - choiceText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u0430 \u0434\u0435\u0432\u0443\u0448\u043A\u0430
      \u0432\u043E\u0440\u043E\u0432\u0430\u043B\u0430?"
    nextNode: {fileID: 11400000, guid: beebdc804bdc21248917a0069b4f8ea8, type: 2}
  - choiceText: "\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u043E \u0447\u0435\u043C
      \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435"
    nextNode: {fileID: 11400000, guid: b89913727f98daf428db09861733b3e3, type: 2}
