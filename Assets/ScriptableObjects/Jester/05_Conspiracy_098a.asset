  backgroundSprite: {fileID: -5279148918026705717, guid: f644018147ae75e47b6d97d3c0c18ebf, type: 3}
  dialogueText: "\u041A\u043E\u0440\u043E\u043B\u044C \u043F\u043E\u0436\u0430\u043B
    \u043F\u043B\u0435\u0447\u0430\u043C\u0438, \u0434\u0430\u0432\u0430\u044F \u0442\u0435\u0431\u0435
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435. \u0422\u044B \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u043B\u0441\u044F
    \u043A \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0434\u0435\u0432\u0443\u0448\u043A\u0435,
    \u043D\u0430\u043A\u0438\u043D\u0443\u043B \u043D\u0430 \u0435\u0435 \u043F\u043B\u0435\u0447\u0438
    \u0441\u0432\u043E\u0439 \u043A\u0430\u043C\u0437\u043E\u043B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0442\u0443\u0442 \u0436\u0435 \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043B\u0441\u044F
    \u043A\u0440\u043E\u0432\u044C\u044E. \u0415\u0433\u043E \u0443\u0436\u0435 \u043D\u0435
    \u0441\u043F\u0430\u0441\u0442\u0438, \u043A\u0430\u043A \u0438 \u0434\u0435\u0432\u0443\u0448\u043A\u0443."
