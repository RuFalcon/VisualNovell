  backgroundSprite: {fileID: -5279148918026705717, guid: f644018147ae75e47b6d97d3c0c18ebf, type: 3}
  dialogueText: "\u0423 \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u043A\u0438
    \u0438\u0437 \u0433\u043B\u0430\u0437 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
    \u0441\u043B\u0435\u0437\u044B. \u041E\u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
    \u0440\u043E\u0442, \u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u043E\u0436\u0435
    \u0445\u043B\u0435\u0441\u0442\u0430\u043B\u0430 \u043A\u0440\u043E\u0432\u044C.
    \u0415\u0439 \u043E\u0442\u0440\u0435\u0437\u0430\u043B\u0438 \u044F\u0437\u044B\u043A,
    \u043F\u0440\u0438\u0447\u0435\u043C \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
    - \u0438\u043D\u0430\u0447\u0435 \u0431\u044B \u043E\u043D\u0430 \u0443\u043C\u0435\u0440\u043B\u0430
    \u043E\u0442 \u043F\u043E\u0442\u0435\u0440\u0438 \u043A\u0440\u043E\u0432\u0438.
    \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E
    \u043E\u043D\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
    \u043F\u043B\u0435\u043D\u043D\u0438\u0446\u0430 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044C
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0436\u0435\u0441\u0442\u0430\u043C\u0438:
    \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u0447\u0442\u043E-\u0442\u043E \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
    \u0443\u043A\u0443\u0441\u0438\u0442\u044C."
