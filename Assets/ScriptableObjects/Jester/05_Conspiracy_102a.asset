  backgroundSprite: {fileID: -5279148918026705717, guid: f644018147ae75e47b6d97d3c0c18ebf, type: 3}
  dialogueText: "\u041F\u043B\u0435\u043D\u043D\u0438\u0446\u0430 \u0431\u044B\u0441\u0442\u0440\u043E
    \u0437\u0430\u043A\u0438\u0432\u0430\u043B\u0430 \u0438 \u0441\u043D\u043E\u0432\u0430
    \u0437\u0430\u043F\u043B\u0430\u043A\u0430\u043B\u0430. \u0412\u044B \u0432\u0441\u0442\u0430\u043B
    \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0420\u043E\u0431\u0435\u0440\u0442\u0443.
    \u0412 \u0433\u043B\u0430\u0437\u0430\u0445 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430
    \u0433\u043E\u0440\u0435\u043B \u0432\u0435\u0441\u0435\u043B\u044B\u0439 \u043E\u0433\u043E\u043D\u0435\u043A
    \u043E\u0437\u043E\u0440\u0441\u0442\u0432\u0430. \u041D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
    \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u043E\u0442\u0440\u0435\u0437\u0430\u043B
    \u0435\u0439 \u044F\u0437\u044B\u043A - \u044D\u0442\u043E \u0436\u0435 \u0447\u0435\u0440\u0442\u043E\u0432\u0441\u043A\u0438
    \u0432\u0435\u0441\u0435\u043B\u043E."
