  backgroundSprite: {fileID: -5279148918026705717, guid: f644018147ae75e47b6d97d3c0c18ebf, type: 3}
  dialogueText: "\u0420\u043E\u0431\u0435\u0440\u0442, \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0439...
    \u041D\u0435 \u0432\u0441\u0435 \u0436\u0438\u0432\u0443\u0442 \u043F\u043E \u0437\u0430\u043A\u043E\u043D\u0443,
    \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430. \u0418 \u043E\u0434\u043D\u043E
    \u0434\u0435\u043B\u043E - \u043A\u0430\u0437\u043D\u0438\u0442\u044C \u0438\u0445
    \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438, \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445
    \u0432\u0441\u0435\u0445 \u043B\u044E\u0434\u0435\u0439, \u0438 \u0441\u043E\u0432\u0441\u0435\u043C
    \u0434\u0440\u0443\u0433\u043E\u0435 - \u043F\u044B\u0442\u0430\u0442\u044C \u0432
    \u043F\u043E\u0434\u0432\u0430\u043B\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B\u0438
    \u043E\u0434\u043D\u0443 \u043E\u0448\u0438\u0431\u043A\u0443. \u041D\u0435\u0443\u0436\u0435\u043B\u0438
    \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C, \u0447\u0442\u043E\u0431\u044B
    \u0432\u0441\u0435 \u0442\u0432\u043E\u0435 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E
    \u0436\u0438\u043B\u043E \u0432 \u0441\u0442\u0440\u0430\u0445\u0435 \u043F\u0435\u0440\u0435\u0434
    \u0442\u0430\u043A\u0438\u043C \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u043C?"
