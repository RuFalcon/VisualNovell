  backgroundSprite: {fileID: -5279148918026705717, guid: f644018147ae75e47b6d97d3c0c18ebf, type: 3}
  dialogueText: "\u0422\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B
    \u0432\u0441\u0435. \u0421\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u043A\u0438\u043D\u0436\u0430\u043B
    - \u0432\u043E\u0442 \u043E\u043D, \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439
    - \u0438 \u0443\u0434\u0430\u0440\u0438\u0442\u044C \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E
    \u043A\u043E\u0440\u043E\u043B\u044F \u043F\u0440\u044F\u043C\u043E \u0432 \u0441\u0435\u0440\u0434\u0446\u0435.
    \u041E\u043D \u0441\u043B\u0430\u0431\u044B\u0439 \u0440\u0435\u0431\u0435\u043D\u043E\u043A,
    \u043E\u043D \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u044F
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C. \u0414\u0430, \u0442\u0435\u0431\u044F
    \u0443\u0431\u044C\u044E\u0442 \u0435\u0433\u043E \u043D\u0430\u0435\u043C\u043D\u0438\u043A\u0438,
    \u043D\u043E \u0437\u0430\u0442\u043E \u0442\u044B \u0438\u0437\u0431\u0430\u0432\u0438\u0448\u044C\u0441\u044F
    \u043E\u0442 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0437\u043B\u0430
    \u0432 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0435."
