  backgroundSprite: {fileID: -5413260449381860318, guid: d30505fb87131bd45a0fd7ddfee0c47a, type: 3}
  dialogueText: "\u0422\u044B \u0432\u043E \u0432\u0441\u0435\u043C \u043F\u043E\u0442\u0430\u043A\u0430\u0435\u0448\u044C
    \u0441\u0432\u043E\u0435\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u044E. \u0422\u044B
    - \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439, \u043A\u043E\u043C\u0443
    \u043E\u043D \u0431\u0435\u0437\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0447\u043D\u043E
    \u0432\u0435\u0440\u0438\u0442. \u0422\u0435\u0431\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043E\u0441\u0442\u0440\u0438\u0442\u044C
    \u0438\u043B\u0438 \u0436\u043E\u043D\u0433\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
    \u0438\u043B\u0438 \u043F\u0435\u0442\u044C \u043D\u0430 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u044F\u0445
    \u0434\u043B\u044F \u0433\u043E\u0441\u0442\u0435\u0439 \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A
    \u043A\u043E\u0440\u043E\u043B\u044F \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0442\u043E\u043B\u043F\u0443."
