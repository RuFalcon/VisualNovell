  backgroundSprite: {fileID: -5413260449381860318, guid: d30505fb87131bd45a0fd7ddfee0c47a, type: 3}
  dialogueText: "\u041E\u0434\u043D\u0430\u043A\u043E, \u0442\u044B \u043D\u0435
    \u0441\u043E\u0432\u0441\u0435\u043C \u0443\u0432\u0435\u0440\u0435\u043D, \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
    \u043B\u0438 \u0432\u044B\u0431\u043E\u0440 \u0441\u0434\u0435\u043B\u0430\u043B.
    \u0417\u0430\u0432\u0442\u0440\u0430 - \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u044F
    \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F, \u0433\u0434\u0435
    \u0420\u043E\u0431\u0435\u0440\u0442 \u0441\u0442\u0430\u043D\u0435\u0442 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u043C
    \u043A\u043E\u0440\u043E\u043B\u0435\u043C."
  choices:
  - choiceText: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0441\u0442\u0430\u043B\u0430
      \u043F\u043E\u0440\u0430 \u0435\u0433\u043E  \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C"
    nextNode: {fileID: 11400000, guid: 59d4dccd40ee43346874d0375ead0d37, type: 2}
  - choiceText: "\u041C\u044B \u0431\u0443\u0434\u0435\u043C \u043F\u0440\u0430\u0432\u0438\u0442\u044C
