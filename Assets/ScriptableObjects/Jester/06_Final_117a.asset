  dialogueText: "\u0412\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0435
    \u0432\u0435\u0447\u0435\u0440 \u0432\u043C\u0435\u0441\u0442\u0435, \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F
    \u0434\u0435\u0442\u0441\u043A\u0438\u0435 \u0433\u043E\u0434\u044B \u043F\u0440\u0438\u043D\u0446\u0430,
    \u0442\u0432\u043E\u0438 \u0448\u0443\u0442\u043A\u0438. \u0422\u044B \u043F\u043E\u0435\u0448\u044C
    \u0438 \u0432\u0435\u0441\u0435\u043B\u0438\u0448\u044C\u0441\u044F, \u0420\u043E\u0431\u0435\u0440\u0442
    \u0434\u0430\u0436\u0435 \u0442\u0430\u043D\u0446\u0443\u0435\u0442. \u0412\u044B
    \u0443\u0436\u0435 \u0432\u044B\u043F\u0438\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0432\u0438\u043D\u0430,
    \u0447\u0442\u043E \u043D\u0438\u0447\u0442\u043E \u043D\u0435 \u0441\u043F\u0430\u0441\u0435\u0442
    \u0432\u0430\u0441."
