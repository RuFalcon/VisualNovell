  backgroundSprite: {fileID: 21300000, guid: 38a52f2be4a39f8489eef9df23077b17, type: 3}
  dialogueText: "\u0420\u043E\u0431\u0435\u0440\u0442 \u043C\u043E\u043B\u0447\u0430
    \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B \u0442\u0435\u0431\u044F. \u041E\u043D
    \u043D\u0435 \u0437\u043B\u0438\u043B\u0441\u044F, \u043D\u0435 \u043A\u0440\u0438\u0447\u0430\u043B.
    \u041D\u0435 \u0441\u0442\u0430\u043B \u0437\u0432\u0430\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u0443.
    - \u041F\u043E\u0447\u0435\u043C\u0443? \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0432\u043E\u043F\u0440\u043E\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043E\u043D \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441."
  choices: []
  nextNode: {fileID: 0}
  isEnding: 1
  endingText: "\u0422\u044B \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u043C\u0430\u043B\u044B\u0448\u0443, \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C
    \u0447\u0442\u043E-\u0442\u043E... \u043D\u043E \u0442\u0432\u043E\u044F \u0440\u0435\u0447\u044C
    \u0431\u044B\u043B\u0430 \u0432\u0441\u0435 \u043C\u0435\u043D\u0435\u0435 \u043F\u043E\u043D\u044F\u0442\u043D\u0430,
    \u0438 \u0432 \u043A\u043E\u043D\u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043F\u0435\u0440\u0435\u0448\u043B\u0430 \u0432 \u043F\u0440\u0435\u0434\u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439
    \u0445\u0440\u0438\u043F."
