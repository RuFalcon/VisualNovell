  dialogueText: "\u0422\u044B \u0420\u043E\u0431\u0438\u043D \u0413\u0443\u0434.
    \u0422\u044B \u0438 \u0442\u0432\u043E\u044F \u0448\u0430\u0439\u043A\u0430 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432,
