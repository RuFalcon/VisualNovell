  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: c961f99999aac3b46a5c3f33719a3823, type: 3}
  dialogueText: "\u0414\u043E \u0442\u0435\u0431\u044F \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u0441\u0442\u0443\u043A \u043A\u043E\u043F\u044B\u0442 \u0438 \u0433\u0440\u043E\u043C\u044B\u0445\u0430\u043D\u0438\u0435
    \u043A\u043E\u043B\u0451\u0441. \u0412\u044B\u0433\u043B\u044F\u043D\u0443\u0432
    \u0438\u0437 \u043A\u0430\u043D\u0430\u0432\u044B, \u0432\u0438\u0434\u0438\u0448\u044C
    \u043A\u0440\u044B\u0442\u044B\u0439 \u0444\u0443\u0440\u0433\u043E\u043D \u043A\u0443\u043F\u0446\u0430
    \u0438 \u0435\u0434\u0443\u0449\u0438\u0445 \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C
    \u0434\u0432\u0443\u0445 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
    \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432. \u041A\u0443\u043F\u0435\u0446
    \u0441\u0430\u043C \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043A\u043E\u0437\u043B\u0430\u0445
    \u0438 \u043F\u0440\u0430\u0432\u0438\u0442 \u043B\u043E\u0448\u0430\u0434\u044C\u044E."
  choices:
  - choiceText: "\u041D\u0430\u043F\u0430\u0441\u0442\u044C \u043D\u0430 \u043A\u0443\u043F\u0446\u0430
      \u0438 \u043E\u0445\u0440\u0430\u043D\u0443"
    nextNode: {fileID: 11400000, guid: ceda304e0b15d3a44a4b3e2c813661bb, type: 2}
  - choiceText: "\u041F\u0440\u043E\u0448\u043C\u044B\u0433\u043D\u0443\u0442\u044C
