  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: 4890562aecb37e0468b3afa1fb4df751, type: 3}
  dialogueText: "\u041D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0448\u044C
    \u043B\u0443\u043A, \u0446\u0435\u043B\u0438\u0448\u044C\u0441\u044F \u0432 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430 \u0438 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0448\u044C
    \u0442\u0435\u0442\u0438\u0432\u0443. \u0421\u0442\u0440\u0435\u043B\u0430 \u0431\u044C\u0451\u0442
    \u0435\u0433\u043E \u0432 \u043A\u043E\u0440\u043F\u0443\u0441, \u043D\u043E
    \u0442\u043E\u0442 \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0442 \u043F\u0430\u0434\u0430\u0442\u044C.
    \u041D\u0435 \u0438\u043D\u0430\u0447\u0435, \u0443 \u043D\u0435\u0433\u043E
    \u0434\u043E\u0441\u043F\u0435\u0445 \u043F\u043E\u0434 \u0442\u0443\u043D\u0438\u043A\u043E\u0439!
    \u041E\u0445\u0440\u0430\u043D\u0430 \u0443\u0441\u0442\u0440\u0435\u043C\u043B\u044F\u0435\u0442\u0441\u044F
    \u043A \u0442\u0435\u0431\u0435. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0448\u044C
    \u0435\u0449\u0451 \u043E\u0434\u043D\u0443 \u0441\u0442\u0440\u0435\u043B\u0443,
    \u043D\u043E \u043E\u043D\u0430 \u0442\u0430\u043A\u0436\u0435 \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442
    \u043E\u0442 \u0434\u043E\u0441\u043F\u0435\u0445\u043E\u0432. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
    \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u044E\u0442\u0441\u044F."
  choices:
  - choiceText: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0431\u043E\u0439"
