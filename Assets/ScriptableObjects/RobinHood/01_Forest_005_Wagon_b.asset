  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: 4bd04a2c75ed32540be90d468bbbf819, type: 3}
  dialogueText: "\u0416\u0434\u0451\u0448\u044C, \u043F\u043E\u043A\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
    \u043D\u0435 \u043F\u0440\u043E\u0435\u0434\u0443\u0442, \u0430 \u0444\u0443\u0440\u0433\u043E\u043D
    \u043D\u0435 \u043F\u043E\u0440\u0430\u0432\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u0442\u043E\u0431\u043E\u0439. \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
    \u0432\u044B\u043B\u0435\u0437\u0430\u0435\u0448\u044C \u0438\u0437 \u043A\u0430\u043D\u0430\u0432\u044B
    \u0438 \u043F\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E \u0437\u0430\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0448\u044C
    \u0432 \u0444\u0443\u0440\u0433\u043E\u043D \u0441\u0437\u0430\u0434\u0438. \u0414\u043E\u0441\u0442\u0430\u0432
    \u043D\u043E\u0436, \u0432\u0441\u043F\u0430\u0440\u044B\u0432\u0430\u0435\u0448\u044C
    \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u0443 \u0438 \u0437\u0430\u0445\u043E\u0434\u0438\u0448\u044C
    \u0432\u043D\u0443\u0442\u0440\u044C. \u0422\u0430\u043C \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u0447\u043E\u043D\u043A\u043E\u0432
    \u0438 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445 \u0441\u0443\u043D\u0434\u0443\u0447\u043A\u043E\u0432."
  choices:
  - choiceText: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u0447\u0442\u043E
