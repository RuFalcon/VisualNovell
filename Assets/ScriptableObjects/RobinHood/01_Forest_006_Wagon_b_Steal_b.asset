  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: 4bd04a2c75ed32540be90d468bbbf819, type: 3}
  dialogueText: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u0432\u0437\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0448\u044C
    \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0441\u0443\u043D\u0434\u0443\u0447\u043E\u043A
    \u0438 \u0432\u0438\u0434\u0438\u0448\u044C \u0441\u043E\u0442\u043D\u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
    \u043C\u043E\u043D\u0435\u0442. \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C
    \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0443\u043D\u0434\u0443\u0447\u043E\u043A,
    \u0438 \u0441\u043D\u043E\u0432\u0430 \u0432\u0438\u0434\u0438\u0448\u044C \u043C\u043E\u043D\u0435\u0442\u044B!
    \u041E\u0433\u043E, \u0430 \u0434\u0438\u0447\u044C-\u0442\u043E \u0438 \u0432
    \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0436\u0438\u0440\u043D\u0430\u044F!
    \u041E\u0434\u043D\u0430\u043A\u043E, \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C,
    \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0441\u0443\u043D\u0434\u0443\u0447\u043A\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435
    \u0443\u043D\u0435\u0441\u0442\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C \u0441\u0435\u0431\u044F,
    \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
  choices:
  - choiceText: "\u0412\u0437\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0443\u043D\u0434\u0443\u0447\u043E\u043A"
    nextNode: {fileID: 11400000, guid: b7b32f3a14971754f8d76f12375b1193, type: 2}
  - choiceText: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0444\u0443\u0440\u0433\u043E\u043D"
