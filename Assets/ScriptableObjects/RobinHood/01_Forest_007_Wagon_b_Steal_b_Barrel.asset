  backgroundSprite: {fileID: 21300000, guid: 4bd04a2c75ed32540be90d468bbbf819, type: 3}
  dialogueText: "\u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C \u0441\u0443\u043D\u0434\u0443\u0447\u043E\u043A
    \u0438 \u0442\u043E\u043B\u043A\u0430\u0435\u0448\u044C \u043A \u0437\u0430\u0434\u0443
    \u0444\u0443\u0440\u0433\u043E\u043D\u0430. \u0412\u0434\u0440\u0443\u0433 \u0444\u0443\u0440\u0433\u043E\u043D
    \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442 \u0432 \u043A\u043E\u043B\u0434\u043E\u0431\u0438\u043D\u0443,
    \u043E\u0442\u0447\u0435\u0433\u043E \u0441\u0443\u043D\u0434\u0443\u0447\u043E\u043A
    \u0432\u044B\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0440\u0443\u0436\u0443
    \u0438 \u0433\u0440\u043E\u0445\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043B\u0435\u0441\u043D\u0443\u044E
    \u0434\u043E\u0440\u043E\u0433\u0443. \u0420\u0430\u0437\u0434\u0430\u044E\u0442\u0441\u044F
    \u0433\u0440\u043E\u043C\u043A\u0438\u0435 \u043A\u0440\u0438\u043A\u0438, \u0444\u0443\u0440\u0433\u043E\u043D
    \u0440\u0435\u0437\u043A\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
    \u0412\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0448\u044C \u043D\u0430\u0440\u0443\u0436\u0443
    \u0438 \u0432\u0438\u0434\u0438\u0448\u044C \u0443\u0441\u0442\u0440\u0435\u043C\u0438\u0432\u0448\u0438\u0445\u0441\u044F
    \u043A \u0442\u0435\u0431\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432."
