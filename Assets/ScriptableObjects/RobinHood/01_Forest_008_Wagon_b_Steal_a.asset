  backgroundSprite: {fileID: 21300000, guid: 4bd04a2c75ed32540be90d468bbbf819, type: 3}
  dialogueText: "\u0422\u044B \u0432\u044B\u0434\u0430\u043B \u0441\u0435\u0431\u044F!
    \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u043E\u0432\u044B\u0439 \u043A\u043B\u0430\u043F\u0430\u043D
    \u043E\u0442\u043B\u0435\u0442\u0430\u0435\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
    \u0438 \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C \u043A\u0443\u043F\u0446\u0430,
    \u043D\u0430\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0435\u0433\u043E \u043D\u0430
    \u0442\u0435\u0431\u044F \u0437\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439
    \u0430\u0440\u0431\u0430\u043B\u0435\u0442. \u0410 \u0435\u0449\u0451 \u0442\u044B
    \u0432\u0438\u0434\u0438\u0448\u044C \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
    \u043A\u0443\u043F\u0446\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445\u0441\u044F
    \u043A \u0444\u0443\u0440\u0433\u043E\u043D\u0443 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432."
