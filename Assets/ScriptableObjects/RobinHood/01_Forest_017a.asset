  backgroundSprite: {fileID: 21300000, guid: 132d1f33cf43b9747856c1da29098762, type: 3}
  dialogueText: "\u0422\u0438\u0448\u0435, \u0420\u043E\u0431\u0438\u043D. \u041C\u044B
    \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C,
    \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u043B\u0443\u0447\u0448\u0435.
    \u041D\u0435\u043B\u044C\u0437\u044F \u0438\u0434\u0442\u0438 \u0432 \u041D\u043E\u0442\u0442\u0438\u0433\u0435\u043C,
    \u043D\u0438\u0447\u0435\u0433\u043E \u0442\u043E\u043B\u043A\u043E\u043C \u043D\u0435
    \u0437\u043D\u0430\u044F, \u0438 \u043D\u0435 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0432
    \u043F\u043B\u0430\u043D. \u0422\u0430\u043A \u043C\u044B \u0441\u0442\u0430\u043D\u0435\u043C
    \u043B\u0451\u0433\u043A\u043E\u0439 \u0434\u043E\u0431\u044B\u0447\u0435\u0439
    \u0434\u043B\u044F \u043B\u044E\u0434\u0435\u0439 \u0448\u0435\u0440\u0438\u0444\u0430
    \u0438 \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u0430."
