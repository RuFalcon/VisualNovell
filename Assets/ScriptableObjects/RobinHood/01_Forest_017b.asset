  character: {fileID: 11400000, guid: e5c2d64239a3fc04a99f801e466196b1, type: 2}
  backgroundSprite: {fileID: 21300000, guid: 132d1f33cf43b9747856c1da29098762, type: 3}
  dialogueText: "\u0415\u0451 \u0437\u0430\u043C\u0430\u043D\u0438\u043B \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0443
    \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u044B\u0439 \u043F\u043E\u0441\u043B\u0430\u043D\u0435\u0446.
    \u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B \u041C\u044D\u0440\u0438\u0430\u043D,
    \u0447\u0442\u043E \u0435\u0451 \u0441\u0442\u0430\u0440\u0430\u044F \u043D\u044F\u043D\u044E\u0448\u043A\u0430
    \u0431\u043E\u043B\u044C\u043D\u0430. \u041E\u043D\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
    \u0434\u043E\u043C\u043E\u0439 \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C
    \u0441\u0442\u0430\u0440\u0443\u0448\u043A\u0443, \u043D\u043E \u043B\u044E\u0434\u0438
    \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u0430 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438
    \u0435\u0439 \u0437\u0430\u0441\u0430\u0434\u0443. \u041E\u043D\u0438 \u043E\u0442\u0432\u0435\u043B\u0438
    \u041C\u044D\u0440\u0438\u0430\u043D \u0432 \u041D\u043E\u0442\u0442\u0438\u043D\u0433\u0435\u043C\u0441\u043A\u0438\u0439
    \u0437\u0430\u043C\u043E\u043A, \u0433\u0434\u0435 \u0448\u0435\u0440\u0438\u0444
    \u043E\u0431\u044A\u044F\u0432\u0438\u043B, \u0447\u0442\u043E \u043E\u043D\u0430
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u0435\u0440\u0435\u0434
    \u0441\u0443\u0434\u043E\u043C."
