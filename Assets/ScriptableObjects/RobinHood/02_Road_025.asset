  dialogueText: "\u0422\u0430\u043C \u043E\u0442\u0440\u044F\u0434 \u0441\u043E\u043B\u0434\u0430\u0442
    \u0432 \u0446\u0432\u0435\u0442\u0430\u0445 \u0413\u0430\u044F \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u0430.
    \u041E\u043D\u0438 \u0436\u0433\u0443\u0442 \u0434\u043E\u043C\u0430 \u0438 \u043E\u0442\u0431\u0438\u0440\u0430\u044E\u0442
