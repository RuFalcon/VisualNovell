  backgroundSprite: {fileID: 21300000, guid: d2ae85ac937e5a942aebcb007b0b709d, type: 3}
  dialogueText: "\u0412\u044B \u0431\u044C\u0451\u0442\u0435\u0441\u044C \u0438\u0437\u043E
    \u0432\u0441\u0435\u0445 \u0441\u0438\u043B, \u043D\u043E \u0432\u0441\u043A\u043E\u0440\u0435
    \u0432\u0430\u0441 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
    \u0414\u0436\u043E\u043D \u0438 \u0423\u0438\u043B\u043B \u0421\u043A\u0430\u0440\u043B\u0435\u0442\u0442
    \u043F\u0430\u0434\u0430\u044E\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u044E,
    \u0441\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0435 \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043D\u044B\u043C\u0438
    \u0431\u043E\u043B\u0442\u0430\u043C\u0438, \u0438 \u043F\u043E\u0434 \u043A\u043E\u043D\u0435\u0446
    \u0438\u0437 \u0432\u0441\u0435\u0445 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
    \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u0442\u044B\u2026"
