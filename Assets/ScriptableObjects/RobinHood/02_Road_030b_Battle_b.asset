  backgroundSprite: {fileID: 21300000, guid: 21ab7af498f33e6449c49d20df476115, type: 3}
  dialogueText: "\u041F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C
    \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u043C \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u044C
    \u043B\u0443\u043A\u0438 \u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F.
    \u041F\u043E \u0442\u0432\u043E\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435
    \u0432 \u0432\u043E\u0437\u0434\u0443\u0445 \u0432\u0437\u043B\u0435\u0442\u0430\u0435\u0442
    \u0437\u0430\u043B\u043F \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u044B\u0445
    \u0441\u0442\u0440\u0435\u043B. \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u0430
    \u0432\u0430\u043B\u044F\u0442\u0441\u044F \u043D\u0430 \u0437\u0435\u043C\u043B\u044E.
    \u041D\u0435\u043C\u043D\u043E\u0433\u0438\u0435 \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0435
    \u0432 \u0437\u0430\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
    \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C,
    \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043F\u043E\u043D\u044F\u0442\u044C,
    \u043E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u043F\u0430\u043B\u0438."
