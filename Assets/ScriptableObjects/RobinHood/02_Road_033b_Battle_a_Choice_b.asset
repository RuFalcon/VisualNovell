  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: 21ab7af498f33e6449c49d20df476115, type: 3}
  dialogueText: "\u0412 \u043E\u0442\u0432\u0435\u0442 \u043D\u0430 \u0442\u0432\u043E\u0439
    \u043F\u0440\u0438\u0437\u044B\u0432 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
    \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442 \u0443\u0441\u0438\u043B\u0438\u044F.
    \u0412 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0433\u0443\u0434\u044F\u0442
    \u0441\u0442\u0440\u0435\u043B\u044B \u0438 \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043D\u044B\u0435
    \u0431\u043E\u043B\u0442\u044B. \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043E\u043B\u0434\u0430\u0442
    \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u0447\u043E\u043C
    \u043D\u0430 \u0423\u0438\u043B\u043B\u0430 \u0421\u043A\u0430\u0440\u043B\u0435\u0442\u0442\u0430.
    \u0422\u044B \u0431\u044B\u0441\u0442\u0440\u043E \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C
    \u0441\u0442\u0440\u0435\u043B\u0443, \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0448\u044C
    \u043B\u0443\u043A \u0438 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0448\u044C
    \u0442\u0435\u0442\u0438\u0432\u0443. \u0421\u043E\u043B\u0434\u0430\u0442 \u043F\u0430\u0434\u0430\u0435\u0442
    \u043D\u0430 \u0437\u0435\u043C\u043B\u044E, \u0430 \u0423\u0438\u043B\u043B
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u0442\u0435\u0431\u044F
    \u043A\u0438\u0432\u043A\u043E\u043C. \u041F\u043E\u043D\u0435\u043C\u043D\u043E\u0433\u0443
    \u0447\u0430\u0448\u0430 \u0432\u0435\u0441\u043E\u0432 \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0432\u0430\u0448\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
    \u0438 \u0432\u0441\u043A\u043E\u0440\u0435 \u043D\u0430 \u043D\u043E\u0433\u0430\u0445
    \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043B\u0438\u0448\u044C \u043F\u0430\u0440\u0430
    \u0441\u043E\u043B\u0434\u0430\u0442. \u041E\u043D\u0438 \u0431\u0440\u043E\u0441\u0430\u044E\u0442
    \u043E\u0440\u0443\u0436\u0438\u0435 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442
    \u0440\u0443\u043A\u0438, \u0441\u0434\u0430\u0432\u0430\u044F\u0441\u044C."
