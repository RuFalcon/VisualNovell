  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: b2c9e7e3a862085408f499106194226d, type: 3}
  dialogueText: "\u0412\u044B \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C
    \u043F\u043E\u0442\u0430\u0439\u043D\u044B\u043C\u0438 \u043B\u0435\u0441\u043D\u044B\u043C\u0438
    \u0442\u0440\u043E\u043F\u0430\u043C\u0438, \u043E\u0431\u0445\u043E\u0434\u044F
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \u0437\u0430\u0441\u0430\u0434\u044B
    \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u0430\u2026
    \u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u0442\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0448\u044C
    \u043A \u043A\u0440\u0430\u044E \u043B\u0435\u0441\u0430, \u043E\u0442\u043A\u0443\u0434\u0430
    \u0432\u0438\u0434\u0435\u043D \u0433\u043E\u0440\u043E\u0434 \u041D\u043E\u0442\u0442\u0438\u043D\u0433\u0435\u043C
    \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0437\u0430\u043C\u043A\u043E\u043C.
    \u0412\u0445\u043E\u0434 \u0432 \u0433\u043E\u0440\u043E\u0434 \u0445\u043E\u0440\u043E\u0448\u043E
    \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u043B\u044E\u0434\u044C\u043C\u0438
    \u0448\u0435\u0440\u0438\u0444\u0430."
  choices:
  - choiceText: "\u0415\u0441\u043B\u0438 \u0431\u0440\u0430\u0442 \u0422\u0443\u043A
      \u0437\u043D\u0430\u0435\u0442 \u043E \u0432\u0430\u0448\u0435\u0439 \u0431\u0435\u0434\u0435"
