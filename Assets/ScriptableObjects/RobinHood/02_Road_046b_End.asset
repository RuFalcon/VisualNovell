  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: 06edeec786437fe4e9276c45e761d202, type: 3}
  dialogueText: "\u0412\u043E\u0434\u0443 \u0432\u0441\u043F\u0430\u0440\u044B\u0432\u0430\u044E\u0442
    \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043D\u044B\u0435 \u0431\u043E\u043B\u0442\u044B,
    \u0440\u0430\u043D\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0438\u0437 \u0432\u0430\u0441. \u0422\u0435\u0431\u0435 \u0443\u0434\u0430\u0451\u0442\u0441\u044F
    \u0434\u043E\u043F\u043B\u044B\u0442\u044C \u0434\u043E \u0431\u0435\u0440\u0435\u0433\u0430,
    \u043D\u043E \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0432\u044B\u043B\u0435\u0437\u0430\u0435\u0448\u044C
    \u0438\u0437 \u0432\u043E\u0434\u044B, \u0432 \u0441\u043F\u0438\u043D\u0443
    \u0442\u0435\u0431\u0435 \u0432\u043E\u043D\u0437\u0430\u0435\u0442\u0441\u044F
    \u0431\u043E\u043B\u0442. \u041F\u0430\u0434\u0430\u0435\u0448\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E
    \u0432 \u0432\u043E\u0434\u0443, \u0431\u044B\u0441\u0442\u0440\u043E \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u044E\u0449\u0443\u044E\u0441\u044F
    \u0432 \u043A\u0440\u0430\u0441\u043D\u044B\u0439."
  choices: []
  nextNode: {fileID: 0}
  isEnding: 1
  endingText: "\u041D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E \u0441\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0432\u043E\u0434\u0443, \u043D\u0435 \u0437\u043D\u0430\u044F \u0431\u0440\u043E\u0434\u0443!"
