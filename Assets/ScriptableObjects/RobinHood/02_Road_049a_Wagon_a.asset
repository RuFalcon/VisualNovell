  dialogueText: "\u0412\u043E\u0437\u043D\u0438\u0446\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0443\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u043E\u0431\u0440\u0443-\u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0443.
    \u0417\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0443
    \u0438 \u0435\u0434\u0435\u0442\u0435 \u043A \u041D\u043E\u0442\u0442\u0438\u043D\u0433\u0435\u043C\u0443.
    \u041F\u043E\u0434\u044A\u0435\u0437\u0436\u0430\u044F \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C,
    \u0432\u044B \u043F\u0440\u044F\u0447\u0435\u0442\u0435 \u0441\u0432\u043E\u0451
    \u043E\u0440\u0443\u0436\u0438\u0435 \u0438 \u0443\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
    \u0432 \u0441\u0442\u0430\u0440\u044B\u0435 \u043F\u043B\u0430\u0449\u0438, \u0447\u0442\u043E\u0431\u044B
