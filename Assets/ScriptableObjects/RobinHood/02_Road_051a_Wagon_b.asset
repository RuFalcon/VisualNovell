  backgroundSprite: {fileID: 21300000, guid: a50aef2382a634144a9703830ad150c7, type: 3}
  dialogueText: "\u041E\u0442\u0434\u0430\u0451\u0448\u044C \u0434\u0435\u043D\u044C\u0433\u0438,
    \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0448\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443
    \u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C
    \u0414\u0436\u043E\u043D\u043E\u043C \u0435\u0434\u0435\u0442\u0435 \u043A \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C
    \u0432\u043E\u0440\u043E\u0442\u0430\u043C. \u041F\u043E\u0434\u044A\u0435\u0445\u0430\u0432
    \u043F\u043E\u0431\u043B\u0438\u0436\u0435, \u043D\u0430\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442\u0435
    \u043D\u0430 \u0441\u0435\u0431\u044F \u0434\u043B\u044F \u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0438
    \u0441\u0442\u0430\u0440\u044B\u0435 \u043F\u043B\u0430\u0449\u0438. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0438\u0434\u0443\u0442
    \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439 \u043F\u0435\u0448\u043A\u043E\u043C,
    \u0441\u043F\u0440\u044F\u0442\u0430\u0432 \u043E\u0440\u0443\u0436\u0438\u0435
    \u0438\u0437 \u0432\u0438\u0434\u0443."
