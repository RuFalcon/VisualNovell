  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: f46eda8bbdf5ecf40b1463161df5321e, type: 3}
  dialogueText: "\u0414\u043E\u0441\u0442\u0430\u0451\u0448\u044C \u0443\u043A\u0440\u044B\u0442\u044B\u0439
    \u043F\u043E\u0434 \u043F\u043B\u0430\u0449\u043E\u043C \u043B\u0443\u043A, \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C
    \u0441\u0442\u0440\u0435\u043B\u0443, \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u0435\u0448\u044C\u0441\u044F
    \u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0448\u044C \u0432 \u043F\u0430\u043B\u0430\u0447\u0430.
    \u0418 \u0442\u0443\u0442 \u0436\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
    \u043D\u0430 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u044B\u0445 \u0441\u0442\u0435\u043D\u0430\u0445
    \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442 \u0438\u0437 \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043E\u0432
    \u0432\u043E \u0434\u0432\u043E\u0440. \u041B\u044E\u0434\u0438 \u0441 \u0432\u043E\u043F\u043B\u044F\u043C\u0438
    \u0431\u0440\u043E\u0441\u0430\u044E\u0442\u0441\u044F \u043A\u0442\u043E \u043A\u0443\u0434\u0430.
    \u0412\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0432\u0448\u0438\u0441\u044C
    \u043E\u0431\u0449\u0435\u0439 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u043E\u0439,
    \u0442\u044B \u0441 \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430\u043C\u0438
    \u0441 \u0431\u043E\u0435\u043C \u043F\u0440\u043E\u0440\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
    \u0441\u043A\u0432\u043E\u0437\u044C \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445
    \u044D\u0448\u0430\u0444\u043E\u0442 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432.
    \u0422\u044B \u0441\u0430\u043C \u0441\u0432\u0430\u043B\u0438\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432, \u043D\u043E
    \u0441\u0438\u043B\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043D\u0435\u0440\u0430\u0432\u043D\u044B.
    \u0423\u0438\u043B\u043B \u0421\u043A\u0430\u0440\u043B\u0435\u0442\u0442, \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
    \u0414\u0436\u043E\u043D, \u0431\u0440\u0430\u0442 \u0422\u0443\u043A \u2013
    \u0432\u0441\u0435 \u043E\u043D\u0438 \u043F\u0430\u0434\u0430\u044E\u0442 \u043F\u043E\u0434
    \u0443\u0434\u0430\u0440\u0430\u043C\u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
    \u043C\u0435\u0447\u0435\u0439."
