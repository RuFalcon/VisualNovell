  character: {fileID: 0}
  backgroundSprite: {fileID: 21300000, guid: 020ef9cb018b7be4d9290746be86299e, type: 3}
  dialogueText: "\u0428\u0435\u0440\u0438\u0444 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0422\u044B \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0448\u044C\u0441\u044F
    \u0438 \u0437\u0430\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0448\u044C
    \u043D\u0430 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u0440\u0443\u043A\u0438 \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
    \u0414\u0436\u043E\u043D\u0430, \u0430 \u0442\u043E\u0442 \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
    \u0442\u0435\u0431\u044F \u0432\u0432\u0435\u0440\u0445. \u041F\u0440\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
    \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435, \u043A\u0430\u043A \u0430\u043A\u0440\u043E\u0431\u0430\u0442,
    \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u044F\u0435\u0448\u044C\u0441\u044F
    \u043D\u0430 \u0431\u0430\u043B\u043A\u043E\u043D\u0435, \u0438 \u0442\u0443\u0442
    \u0436\u0435 \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0448\u044C
    \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0448\u0435\u0433\u043E \u0441\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C
    \u0447\u0442\u043E \u043A \u0447\u0435\u043C\u0443 \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u0430
    \u0432\u043D\u0438\u0437. \u041E\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u044B\u0439
    \u0413\u0438\u0441\u0431\u043E\u0440\u043D \u043B\u0435\u0436\u0438\u0442 \u043D\u0430
    \u0437\u0435\u043C\u043B\u0435, \u0430 \u0442\u044B \u043F\u0440\u0438\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C
    \u0441\u0432\u043E\u0439 \u043C\u0435\u0447 \u043A \u0433\u043E\u0440\u043B\u0443
    \u0448\u0435\u0440\u0438\u0444\u0430."
