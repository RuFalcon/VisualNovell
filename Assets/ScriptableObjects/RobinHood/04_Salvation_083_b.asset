    \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C \u0437\u0430\u043C\u043A\u0430.
    \u041F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430\u043C
    \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0432\u0430\u0448\u0438\u0445
