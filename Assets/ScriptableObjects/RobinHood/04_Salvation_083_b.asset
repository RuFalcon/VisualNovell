  dialogueText: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0448\u0435\u0440\u0438\u0444\u0430
    \u043A\u0430\u043A \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u0430, \u0432\u0430\u0448\u0430
