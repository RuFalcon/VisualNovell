  backgroundSprite: {fileID: 21300000, guid: 908a879c19187e143ab2731755135e36, type: 3}
  dialogueText: "\u0422\u044B \u043D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C
    \u0448\u0435\u0440\u0438\u0444\u0443 \u0432\u0430\u0448\u0435 \u0443\u0431\u0435\u0436\u0438\u0449\u0435,
    \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u043F\u0440\u0438\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0448\u044C
    \u0435\u0433\u043E \u043A \u043C\u0443\u043B\u0443 \u0441\u043F\u0438\u043D\u043E\u0439
    \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C
    \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u041D\u043E\u0442\u0442\u0438\u043D\u0433\u0435\u043C\u0430. \u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
    \u0432 \u043B\u0430\u0433\u0435\u0440\u044C, \u0432\u044B \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435
    \u0433\u0440\u0430\u043D\u0434\u0438\u043E\u0437\u043D\u044B\u0439 \u043F\u0438\u0440,
    \u043F\u0440\u0430\u0437\u0434\u043D\u0443\u044F \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435
    \u041C\u044D\u0440\u0438\u0430\u043D \u0438 \u0432\u0430\u0448\u0443 \u043F\u043E\u0431\u0435\u0434\u0443
    \u043D\u0430\u0434 \u0413\u0438\u0441\u0431\u043E\u0440\u043D\u043E\u043C \u0438
    \u0448\u0435\u0440\u0438\u0444\u043E\u043C."
  choices: []
  nextNode: {fileID: 0}
  isEnding: 1
  endingText: "\u0410\u043B\u0430\u043D-\u0430-\u0414\u044D\u0439\u043B \u043F\u043E\u0451\u0442
    \u043F\u0435\u0441\u043D\u044E \u043E \u0432\u0430\u0448\u0435\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C
    \u043F\u043E\u0434\u0432\u0438\u0433\u0435. \u0412\u0441\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
    \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u044E\u0442\u0441\u044F, \u0447\u0442\u043E
    \u0442\u044B \u0432\u043E\u0439\u0434\u0451\u0448\u044C \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u044E
    \u043A\u0430\u043A \u0431\u043E\u0440\u0435\u0446 \u043F\u0440\u043E\u0442\u0438\u0432
    \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
    \u0438 \u0442\u0438\u0440\u0430\u043D\u0438\u0438. \u0422\u044B \u2013 \u043B\u0435\u0433\u0435\u043D\u0434\u0430!"
